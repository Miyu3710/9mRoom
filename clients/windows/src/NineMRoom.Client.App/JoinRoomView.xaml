<UserControl x:Class="NineMRoom.Client.App.JoinRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="加入房间" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
        <TextBlock Text="输入服务端提供的房间号，并设置本次使用的昵称。"
                   Style="{StaticResource Label}" Margin="0,4,0,18" />

        <TextBlock Text="房间号" Style="{StaticResource Label}" Margin="0,0,0,4" />
        <TextBox Text="{Binding JoinRoomCode, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource InputBox}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding JoinRoomInfoText}" Style="{StaticResource Label}" Margin="0,0,0,14" />

        <TextBlock Text="昵称" Style="{StaticResource Label}" Margin="0,0,0,4" />
        <TextBox Text="{Binding JoinRoomName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource InputBox}" Margin="0,0,0,10" />

        <CheckBox Content="以后默认使用此昵称" IsChecked="{Binding JoinRememberName}" Margin="0,0,0,8" />
        <CheckBox Content="设为家房间（仅服务端创建的房间可用）" IsChecked="{Binding JoinSetHome}"
                  IsEnabled="{Binding JoinCanSetHome}" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
            <Button Content="加入房间" Click="Join_Click"
                    Style="{StaticResource ModernPrimaryButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
