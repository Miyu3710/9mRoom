<UserControl x:Class="NineMRoom.Client.App.AppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:StringEqualsConverter x:Key="ValueEquals" />
    <local:InverseBooleanConverter x:Key="Not" />

    <Style x:Key="AppTile" TargetType="ListBoxItem">
      <Setter Property="Width" Value="248" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile"
                    Background="{DynamicResource BrushSurfaceContainerLow}"
                    CornerRadius="{DynamicResource ShapeMedium}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="HoverLayer"
                        Background="{DynamicResource BrushSurfaceContainerHigh}"
                        CornerRadius="{DynamicResource ShapeMedium}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <ContentPresenter />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource BrushPrimaryContainer}" />
                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,28,16">
      <TextBlock Text="应用" Style="{StaticResource PageTitle}" />
      <TextBlock Text="选择要配置的应用；点击一行打开规则编辑面板。"
                 Style="{StaticResource PageSupporting}" />
    </StackPanel>

    <!-- 工具区：搜索字段 + 互斥排序 + 次级动作 -->
    <Grid Grid.Row="1" Margin="0,0,28,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,16,0">
        <TextBox x:Name="AppSearchBox"
                 Style="{StaticResource M3SearchField}"
                 controls:M3Field.Label="搜索应用"
                 Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 controls:M3Field.ShowLeadingIcon="True" />
      </Grid>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,20,0,0"
                  AutomationProperties.Name="应用排序方式">
        <controls:M3SegmentedButton Content="最近使用" Tag="recent" GroupName="AppSort" Position="First"
                                    Checked="Sort_Checked"
                                    IsChecked="{Binding AppSortMode, Converter={StaticResource ValueEquals}, ConverterParameter=recent, Mode=OneWay}" />
        <controls:M3SegmentedButton Content="名称" Tag="name" GroupName="AppSort" Position="Middle"
                                    Checked="Sort_Checked"
                                    IsChecked="{Binding AppSortMode, Converter={StaticResource ValueEquals}, ConverterParameter=name, Mode=OneWay}" />
        <controls:M3SegmentedButton Content="分类" Tag="category" GroupName="AppSort" Position="Last"
                                    Checked="Sort_Checked"
                                    IsChecked="{Binding AppSortMode, Converter={StaticResource ValueEquals}, ConverterParameter=category, Mode=OneWay}" />
      </StackPanel>

      <controls:M3Button Grid.Column="2"
                         Style="{StaticResource M3OutlinedButton}"
                         Content="分类管理"
                         AutomationProperties.Name="管理应用分类"
                         VerticalAlignment="Top"
                         Margin="12,20,0,0"
                         Click="CategoryManage_Click" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <ScrollViewer>
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer" BasedOn="{StaticResource M3PageScroll}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAppListEmpty}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <ListBox x:Name="AppList"
                   ItemsSource="{Binding AppRulesView}"
                   ItemContainerStyle="{StaticResource AppTile}"
                   SelectionChanged="AppList_SelectionChanged"
                   AutomationProperties.Name="应用列表"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource ShapeSmall}"
                            Background="{StaticResource BrushPrimaryContainer}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Initial}"
                                 Foreground="{StaticResource BrushOnPrimaryContainer}"
                                 FontSize="{StaticResource TypeTitleMediumSize}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="40" Height="40"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ItemTitle}"
                               Foreground="{StaticResource BrushOnSurface}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CategoryDisplayName}" Style="{StaticResource ItemSupporting}"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="没有匹配的应用。换一个关键词，或清除搜索条件。"
                     Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAppFilterEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ScrollViewer>

      <controls:EmptyState Glyph="Apps"
                           Title="还没有探测到应用"
                           Body="切换一次前台窗口后，9mRoom 会把应用显示在这里，供你配置名称、分类与状态模板。">
        <controls:EmptyState.Style>
          <Style TargetType="{x:Type controls:EmptyState}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAppListEmpty}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:EmptyState.Style>
      </controls:EmptyState>
    </Grid>
  </Grid>
</UserControl>
