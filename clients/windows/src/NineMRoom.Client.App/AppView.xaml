<UserControl x:Class="NineMRoom.Client.App.AppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
</UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,16">
            <TextBlock Text="应用" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="排序" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="最近使用" Tag="recent" Click="Sort_Click" Style="{StaticResource ModernButton}" Margin="0,0,4,0" />
                                <Button Content="名称" Tag="name" Click="Sort_Click" Style="{StaticResource ModernButton}" Margin="0,0,4,0" />
                                <Button Content="分类" Tag="category" Click="Sort_Click" Style="{StaticResource ModernButton}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding AppSortLabel, StringFormat=当前：{0}}" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" />
                                <Button Content="分类管理" Click="CategoryManage_Click"
                                        Style="{StaticResource ModernButton}" Margin="14,0,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="238" Height="64"
                                    Background="{StaticResource BrushControlBg}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0" CornerRadius="{StaticResource RadiusSm}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    MouseLeftButtonDown="SearchBox_Click">
                                <Grid>
                                    <TextBox x:Name="AppSearchBox"
                                             Style="{StaticResource InputBox}"
                                             Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="支持应用名、原应用名、进程名和应用分类"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,34,0" />
                                    <TextBlock Text="搜索应用、原应用名或分类"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="11,0,30,0"
                                               FontSize="{StaticResource FontSizeSm}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AppSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="×" Click="ClearSearch_Click"
                                            Style="{StaticResource ModernButton}"
                                            Padding="0" Width="24" Height="24"
                                            FontSize="{StaticResource FontSizeMd}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,5,0"
                                            Visibility="{Binding HasAppSearch, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="探测到的应用" Style="{StaticResource Label}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding AppRulesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190" Margin="0,0,10,10" Padding="10"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource RadiusSm}" Cursor="Hand"
                                            MouseLeftButtonUp="AppTile_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                                <Border CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Initial}" Foreground="{StaticResource BrushOnAccent}"
                                                               FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Icon}" Width="36" Height="36"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CategoryDisplayName}" Style="{StaticResource Label}"
                                                           FontSize="{StaticResource FontSizeXs}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="没有匹配的应用" Style="{StaticResource Label}" Margin="0,2,0,0"
                                   Visibility="{Binding IsAppFilterEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="还没有探测到应用。切换一次前台窗口后会自动出现。"
                                   Style="{StaticResource Label}" Margin="0,2,0,0"
                                   Visibility="{Binding IsAppListEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
