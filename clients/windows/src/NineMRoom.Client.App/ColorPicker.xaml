<UserControl x:Class="NineMRoom.Client.App.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="HexBox" Style="{StaticResource InputBox}" FontSize="{StaticResource FontSizeSm}" />
        <Button Grid.Column="1" Click="OpenPalette_Click" Width="32" Height="32" Margin="4,0,0,0"
                Style="{StaticResource MaterialDesignIconButton}" ToolTip="选择颜色">
            <Border x:Name="Swatch" Width="16" Height="16" CornerRadius="3"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
        </Button>

        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=HexBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource BrushSurfaceAlt}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0"
                    CornerRadius="{StaticResource RadiusMd}" Padding="8" Margin="0,4,0,0">
                <WrapPanel x:Name="Palette" Width="216" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
