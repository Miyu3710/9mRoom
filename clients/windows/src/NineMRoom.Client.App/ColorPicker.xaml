<UserControl x:Class="NineMRoom.Client.App.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBox x:Name="HexBox" Style="{StaticResource M3TextBoxCompact}"
             controls:M3Field.Label="颜色值"
             FontSize="{StaticResource TypeBodySmallSize}"
             ToolTip="支持 #RRGGBB 或 #AARRGGBB" />

    <controls:M3Button Grid.Column="1"
                       Style="{StaticResource M3IconButton}"
                       ToolTip="选择颜色"
                       AutomationProperties.Name="选择颜色"
                       Margin="4,4,0,0"
                       VerticalAlignment="Top"
                       Click="OpenPalette_Click">
      <Border x:Name="Swatch" Width="18" Height="18" CornerRadius="4"
              BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1" />
    </controls:M3Button>

    <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=HexBox}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="{StaticResource BrushSurfaceContainerHigh}"
              BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
              CornerRadius="{StaticResource ShapeMedium}" Padding="8" Margin="0,4,0,0">
        <WrapPanel x:Name="Palette" Width="216" />
      </Border>
    </Popup>
  </Grid>
</UserControl>
