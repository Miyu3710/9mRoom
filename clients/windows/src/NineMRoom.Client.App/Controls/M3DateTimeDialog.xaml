<Window x:Class="NineMRoom.Client.App.Controls.M3DateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="选择时间"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource BrushOnSurface}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="M3DateDayButton" TargetType="{x:Type controls:M3Button}"
           BasedOn="{StaticResource M3TextButton}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}" />
      <Setter Property="controls:M3Button.CornerRadius" Value="{StaticResource ShapeSmall}" />
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource M3DialogSurface}" Margin="16">
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="选择日期与时间" Style="{DynamicResource M3HeadlineSmall}" />
          <TextBlock Text="日期使用 M3 日期网格；时间用键盘输入（24 小时制）。"
                     Style="{StaticResource ItemSupporting}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <controls:M3Button HorizontalAlignment="Right" VerticalAlignment="Top"
                           Style="{StaticResource M3IconButton}"
                           ToolTip="关闭"
                           AutomationProperties.Name="关闭时间选择"
                           Click="Cancel_Click">
          <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
      </Grid>

      <!-- M3 date picker: month header + weekday row + 6x7 day grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:M3Button Grid.Column="0" Style="{StaticResource M3IconButton}"
                           ToolTip="上个月" AutomationProperties.Name="上个月"
                           Click="PreviousMonth_Click">
          <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
        <TextBlock x:Name="MonthTitle" Grid.Column="1"
                   Style="{DynamicResource M3TitleMedium}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <controls:M3Button Grid.Column="2" Style="{StaticResource M3IconButton}"
                           ToolTip="下个月" AutomationProperties.Name="下个月"
                           Click="NextMonth_Click">
          <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
      </Grid>

      <UniformGrid Columns="7" Margin="0,4,0,0">
        <TextBlock Text="一" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="二" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="三" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="四" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="五" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="六" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
        <TextBlock Text="日" Style="{StaticResource ItemSupporting}" HorizontalAlignment="Center" />
      </UniformGrid>

      <ItemsControl x:Name="DayGrid" Margin="0,4,0,0" AutomationProperties.Name="日期网格">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:M3Button Tag="{Binding}" Click="Day_Click">
              <controls:M3Button.Style>
                <Style TargetType="{x:Type controls:M3Button}" BasedOn="{StaticResource M3DateDayButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}" />
                      <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                      <Setter Property="BorderThickness" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                      <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:M3Button.Style>
              <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:M3Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="HourBox" Grid.Column="0" Width="72" MaxLength="2"
                 controls:M3Field.Label="时" Style="{StaticResource M3TextBoxCompact}"
                 VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="6,0,6,0"
                   FontSize="{DynamicResource TypeTitleMediumSize}" />
        <TextBox x:Name="MinuteBox" Grid.Column="2" Width="72" MaxLength="2"
                 controls:M3Field.Label="分" Style="{StaticResource M3TextBoxCompact}"
                 VerticalAlignment="Top" />

        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="已选" Style="{StaticResource ItemSupporting}" />
          <TextBlock x:Name="PreviewText" Style="{StaticResource ValueText}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                 Visibility="Collapsed" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="清除" Click="Clear_Click" />
        <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="取消" Click="Cancel_Click" Margin="8,0,0,0" />
        <controls:M3Button Style="{StaticResource M3TextButton}" Content="确定" Click="Ok_Click" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
