<UserControl x:Class="NineMRoom.Client.App.Controls.InfoHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             Focusable="False">
  <controls:M3Button x:Name="HintButton"
          Style="{StaticResource M3IconButton}"
          Width="18" Height="18"
          MinWidth="0" MinHeight="0"
          Padding="0"
          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
          Background="Transparent"
          ToolTipService.InitialShowDelay="220"
          AutomationProperties.Name="查看说明"
          Click="HintButton_Click">
    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="14" Height="14"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
  </controls:M3Button>
</UserControl>
