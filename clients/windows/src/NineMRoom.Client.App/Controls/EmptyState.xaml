<UserControl x:Class="NineMRoom.Client.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             
             TextElement.Foreground="{DynamicResource BrushOnSurface}">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="460" Margin="24">
    <Border Width="72" Height="72" CornerRadius="36"
            Background="{DynamicResource BrushSecondaryContainer}"
            HorizontalAlignment="Center">
      <materialDesign:PackIcon Kind="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Width="32" Height="32"
                                Foreground="{DynamicResource BrushOnSecondaryContainer}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Style="{DynamicResource M3HeadlineSmall}"
               TextAlignment="Center" TextWrapping="Wrap"
               Margin="0,20,0,0" />
    <TextBlock Text="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Style="{DynamicResource M3BodyMedium}"
               Foreground="{DynamicResource BrushOnSurfaceVariant}"
               TextAlignment="Center" TextWrapping="Wrap"
               Margin="0,8,0,0" />
    <ContentPresenter Content="{Binding ActionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      HorizontalAlignment="Center"
                      Margin="0,20,0,0" />
  </StackPanel>
</UserControl>
