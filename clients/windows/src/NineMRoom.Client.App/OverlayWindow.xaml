<Window x:Class="NineMRoom.Client.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="9mRoom HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="420"
        SizeToContent="Height"
        FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}"
        Cursor="SizeAll">

    <Window.Resources>
        <SolidColorBrush x:Key="OverlayTextBrush" Color="{StaticResource ColorOnSurface}" />
        <SolidColorBrush x:Key="OverlayMutedBrush" Color="{StaticResource ColorOnSurfaceVariant}" />
        <sys:Double x:Key="OverlayFontSize">12</sys:Double>
        <FontWeight x:Key="OverlayNameWeight">SemiBold</FontWeight>

        <DataTemplate x:Key="TwoLineTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource OverlayTextBrush}"
                               FontFamily="{DynamicResource OverlayFontFamily}"
                               FontSize="{DynamicResource OverlayFontSize}"
                               FontWeight="{DynamicResource OverlayNameWeight}" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource OverlayMutedBrush}"
                               FontFamily="{DynamicResource OverlayFontFamily}"
                               FontSize="{DynamicResource OverlayFontSize}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OneLineTemplate">
            <Grid Margin="0,0,0,3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{DynamicResource OverlayTextBrush}"
                           FontFamily="{DynamicResource OverlayFontFamily}"
                           FontSize="{DynamicResource OverlayFontSize}"
                           FontWeight="{DynamicResource OverlayNameWeight}"
                           MaxWidth="96"
                           Margin="0,0,8,0"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource OverlayMutedBrush}"
                           FontFamily="{DynamicResource OverlayFontFamily}"
                           FontSize="{DynamicResource OverlayFontSize}"
                           TextWrapping="{DynamicResource OverlayOneLineWrap}"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource BrushOverlaySurface}"
            BorderBrush="{StaticResource BrushOverlayOutline}"
            BorderThickness="0"
            CornerRadius="{StaticResource ShapeMedium}"
            Padding="14,10">
        <Grid>
            <StackPanel x:Name="MainPanel">
                <Grid Margin="0,0,0,7">
                    <TextBlock x:Name="HeaderText"
                               Text="{Binding OverlayHeader}"
                               Foreground="{DynamicResource OverlayMutedBrush}"
                               FontFamily="{DynamicResource OverlayFontFamily}"
                               FontSize="{StaticResource TypeLabelSmallSize}"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="ConnectionLight"
                             Width="7" Height="7"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             ToolTip="{Binding ConnectionText}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="connected">
                                        <Setter Property="Fill" Value="{StaticResource BrushStatusFocus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="reconnecting">
                                        <Setter Property="Fill" Value="{StaticResource BrushStatusBreak}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="offline">
                                        <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                                    </DataTrigger>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.35" Duration="0:0:1.1"
                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <ScrollViewer x:Name="MembersScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MembersList"
                                  ItemsSource="{Binding Members}"
                                  ItemTemplate="{StaticResource TwoLineTemplate}" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="DockedPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="{Binding OverlayHeader}">
                <Ellipse Width="8" Height="8" HorizontalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="connected">
                                    <Setter Property="Fill" Value="{StaticResource BrushStatusFocus}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="reconnecting">
                                    <Setter Property="Fill" Value="{StaticResource BrushStatusBreak}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="offline">
                                    <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding MemberCountText}"
                           Foreground="{DynamicResource OverlayMutedBrush}"
                           FontFamily="{DynamicResource OverlayFontFamily}"
                           FontSize="{StaticResource TypeLabelSmallSize}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
