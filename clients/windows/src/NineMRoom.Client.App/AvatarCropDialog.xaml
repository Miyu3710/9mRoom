<Window x:Class="NineMRoom.Client.App.AvatarCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="裁剪头像"
        Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource BrushOnSurface}"
        FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">
  <Border Style="{StaticResource M3DialogSurface}" Margin="16">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="裁剪头像" Style="{DynamicResource M3HeadlineSmall}" VerticalAlignment="Center" />
        <controls:M3Button HorizontalAlignment="Right" Style="{StaticResource M3IconButton}"
                           ToolTip="关闭" AutomationProperties.Name="关闭裁剪头像"
                           Click="Cancel_Click">
          <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="360" Height="360" Background="#FF0B0B0D"
                CornerRadius="12" ClipToBounds="True"
                HorizontalAlignment="Left" VerticalAlignment="Top">
          <Grid x:Name="CropViewport" Width="360" Height="360"
                Background="#FF0B0B0D"
                ClipToBounds="True"
                MouseLeftButtonDown="CropViewport_MouseLeftButtonDown"
                MouseMove="CropViewport_MouseMove"
                MouseLeftButtonUp="CropViewport_MouseLeftButtonUp"
                PreviewMouseWheel="CropViewport_PreviewMouseWheel">
            <Canvas x:Name="CropCanvas" Width="360" Height="360" ClipToBounds="False">
              <Image x:Name="CropImage" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" RenderTransformOrigin="0,0">
                <Image.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="ImageScale" />
                    <TranslateTransform x:Name="ImageTranslate" />
                  </TransformGroup>
                </Image.RenderTransform>
              </Image>
            </Canvas>
            <Border IsHitTestVisible="False" BorderBrush="#66FFFFFF" BorderThickness="1" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="24,0,0,0">
          <TextBlock Text="预览" Style="{StaticResource ItemSupporting}" Margin="0,0,0,8" />
          <Grid Width="120" Height="120" HorizontalAlignment="Left">
            <Grid.Clip>
              <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
            </Grid.Clip>
            <Border Background="{StaticResource BrushSurfaceContainerHigh}" />
            <Image x:Name="PreviewImage" Stretch="UniformToFill" />
          </Grid>

          <TextBlock Text="缩放" Style="{StaticResource ItemSupporting}" Margin="0,20,0,6" />
          <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1"
                  TickFrequency="0.1" IsSnapToTickEnabled="False"
                  ValueChanged="ZoomSlider_ValueChanged" />
          <TextBlock Text="拖动图片调整裁剪位置，滑块缩放。" Style="{StaticResource HintText}" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="取消" Click="Cancel_Click" />
        <controls:M3Button Style="{StaticResource M3FilledButton}" Content="确定" Margin="8,0,0,0"
                           Click="Confirm_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
