<UserControl x:Class="NineMRoom.Client.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="0,24,0,4" />
    </Style>
    <Style x:Key="SettingsRow" TargetType="CheckBox" BasedOn="{StaticResource M3Switch}">
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,28,8">
      <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
      <TextBlock Text="所有开关都会立即保存并生效；主题切换需要重启应用。"
                 Style="{StaticResource PageSupporting}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource M3PageScroll}">
      <StackPanel Margin="0,0,0,24">

        <TextBlock Text="外观" Style="{StaticResource SettingsSectionTitle}" />
        <CheckBox Style="{StaticResource SettingsRow}"
                  Content="使用浅色主题"
                  IsChecked="{Binding UseLightTheme}"
                  Margin="0,8,0,0" />
        <TextBlock Text="{Binding ThemeRestartHint}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
        <Border Style="{StaticResource M3Divider}" Margin="0,12,0,0" />

        <TextBlock Text="启动与常驻" Style="{StaticResource SettingsSectionTitle}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="启动时自动连接"
                  IsChecked="{Binding AutoConnect}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="开机自启（静默启动到托盘）"
                  IsChecked="{Binding AutoStart}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="关闭窗口时最小化到托盘"
                  IsChecked="{Binding CloseToTray}"
                  IsEnabled="{Binding TrayAvailable}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="关闭到托盘时显示提示"
                  IsChecked="{Binding NotifyOnClose}" />
        <TextBlock Text="若托盘不可用，关闭窗口将直接退出。全局快捷键：Ctrl+Alt+Shift+T 开始/暂停计时，Ctrl+Alt+H 显示/隐藏叠加层。"
                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
        <Border Style="{StaticResource M3Divider}" Margin="0,12,0,0" />

        <TextBlock Text="通知" Style="{StaticResource SettingsSectionTitle}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="房间成员进入 / 离开时发送系统通知"
                  IsChecked="{Binding NotifyRoomEvents}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="房间聊天消息也显示系统通知"
                  IsChecked="{Binding NotifyRoomChat}" />
        <TextBlock Text="通知通过 Windows 通知中心显示；关闭后不再弹出。"
                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
        <Border Style="{StaticResource M3Divider}" Margin="0,12,0,0" />

        <TextBlock Text="隐私" Style="{StaticResource SettingsSectionTitle}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="共享当前窗口标题"
                  IsChecked="{Binding ShareWindowTitles}" />
        <TextBlock Text="窗口标题只在这个开关开启后上传；关闭时只显示应用名。"
                   Style="{StaticResource HintText}" Margin="0,4,0,0" />

        <CheckBox Style="{StaticResource SettingsRow}" Content="共享当前音乐状态"
                  IsChecked="{Binding ShareMusic}"
                  Margin="0,12,0,0" />
        <TextBlock Text="只展示指定播放器的媒体；按播放器标识子串匹配，多个用英文逗号分隔，留空表示全部。"
                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
        <TextBox Text="{Binding MediaSourceFilter, UpdateSourceTrigger=LostFocus}"
                 Style="{StaticResource M3TextBox}"
                 controls:M3Field.Label="播放器过滤"
                 controls:M3Field.HelperText="例如：Spotify, QQMusic, 网易云"
                 Margin="0,8,0,0"
                 VerticalAlignment="Top" />
        <Border Style="{StaticResource M3Divider}" Margin="0,16,0,0" />

        <TextBlock Text="叠加层" Style="{StaticResource SettingsSectionTitle}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="显示屏幕叠加层"
                  IsChecked="{Binding OverlayEnabled}" />
        <CheckBox Style="{StaticResource SettingsRow}" Content="点击穿透（不遮挡下方窗口）"
                  IsChecked="{Binding OverlayClickThrough}" />

        <TextBlock Text="预设样式" Style="{StaticResource ItemSupporting}" Margin="0,16,0,6" />
        <WrapPanel x:Name="PresetPanel" Orientation="Horizontal" Margin="0,0,0,4">
          <controls:M3SegmentedButton Content="极简单行" Tag="minimal" GroupName="Preset" Position="First"
                                      Checked="Preset_Checked" />
          <controls:M3SegmentedButton Content="紧凑双行" Tag="compact" GroupName="Preset" Position="Middle"
                                      Checked="Preset_Checked" />
          <controls:M3SegmentedButton Content="卡片" Tag="card" GroupName="Preset" Position="Middle"
                                      Checked="Preset_Checked" />
          <controls:M3SegmentedButton Content="字幕条" Tag="subtitle" GroupName="Preset" Position="Middle"
                                      Checked="Preset_Checked" />
          <controls:M3SegmentedButton Content="自定义" Tag="custom" GroupName="Preset" Position="Last"
                                      Checked="Preset_Checked" />
        </WrapPanel>

        <Border Style="{StaticResource M3CardFilled}" Margin="0,8,0,12">
          <StackPanel>
            <TextBlock Text="自定义主题" Style="{StaticResource ItemTitle}" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="字体" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock x:Name="FontSummary" Grid.Column="1" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <controls:M3Button Grid.Column="2" Style="{StaticResource M3OutlinedButton}"
                                 Content="字体…" Click="ChooseFont_Click" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="背景" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock x:Name="BorderSummary" Grid.Column="1" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <controls:M3Button Grid.Column="2" Style="{StaticResource M3OutlinedButton}"
                                 Content="背景…" Click="ChooseBorder_Click" />
            </Grid>

            <Border x:Name="ThemePreview" HorizontalAlignment="Left" Margin="0,8,0,8"
                    BorderThickness="1" CornerRadius="10" Padding="12"
                    Background="#D9232327" BorderBrush="#8034343A">
              <StackPanel>
                <TextBlock x:Name="ThemePreviewHeader" Text="房间 · 2 人在线"
                           FontSize="11" Margin="0,0,0,6" Foreground="#9B9BA4" />
                <TextBlock x:Name="ThemePreviewText" Text="{Binding MyStatusText}"
                           TextWrapping="Wrap" Foreground="#ECECF0" />
              </StackPanel>
            </Border>

            <WrapPanel>
              <controls:M3Button Style="{StaticResource M3FilledButton}" Content="应用自定义"
                                 Click="ApplyCustom_Click" Margin="0,0,8,8" />
              <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="复制当前预设"
                                 Click="CopyPreset_Click" Margin="0,0,8,8" />
              <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="导出 JSON"
                                 Click="Export_Click" Margin="0,0,8,8" />
              <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="导入 JSON"
                                 Click="Import_Click" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="重置叠加层位置"
                           HorizontalAlignment="Left" Click="ResetOverlay_Click" />
        <TextBlock Text="叠加层显示房间内所有成员：在线优先，离线置灰；人数较多时可滚动。"
                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
        <Border Style="{StaticResource M3Divider}" Margin="0,16,0,0" />

        <TextBlock Text="关于" Style="{StaticResource SettingsSectionTitle}" />
        <Border Style="{StaticResource M3Divider}" />
        <Grid MinHeight="56">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="版本" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource ValueText}"
                     VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource M3Divider}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="检查更新"
                             IsBusy="{Binding IsCheckingUpdate}"
                             Click="CheckUpdate_Click" />
          <controls:M3Button Style="{StaticResource M3FilledButton}" Content="下载更新"
                             Margin="8,0,0,0"
                             Click="DownloadUpdate_Click"
                             Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource HintText}" Margin="0,0,0,12" />

        <TextBlock Text="配置文件" Style="{StaticResource ItemSupporting}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding SettingsPathText, Mode=OneWay}"
                   IsReadOnly="True" Style="{StaticResource M3TextBoxCompact}"
                   controls:M3Field.Label="配置文件路径"
                   VerticalAlignment="Top" />
          <controls:M3Button Grid.Column="1" Style="{StaticResource M3IconButton}"
                             ToolTip="复制配置文件路径"
                             AutomationProperties.Name="复制配置文件路径"
                             VerticalAlignment="Top" Margin="4,4,0,0"
                             Click="CopySettingsPath_Click">
            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
        </Grid>

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding LogPathText, Mode=OneWay}"
                   IsReadOnly="True" Style="{StaticResource M3TextBoxCompact}"
                   controls:M3Field.Label="日志目录"
                   VerticalAlignment="Top" />
          <controls:M3Button Grid.Column="1" Style="{StaticResource M3IconButton}"
                             ToolTip="复制日志目录"
                             AutomationProperties.Name="复制日志目录"
                             VerticalAlignment="Top" Margin="4,4,0,0"
                             Click="CopyLogPath_Click">
            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
        </Grid>

        <StackPanel Orientation="Horizontal">
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="打开配置目录"
                             Click="OpenSettingsFolder_Click" />
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="打开日志目录"
                             Margin="8,0,0,0" Click="OpenLogs_Click" />
        </StackPanel>

        <TextBlock Text="当前为未签名构建，Windows SmartScreen 可能提示未知发布者；自动更新尚未启用。"
                   Style="{StaticResource HintText}" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
