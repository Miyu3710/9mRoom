<UserControl x:Class="NineMRoom.Client.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
            <Setter Property="Margin" Value="0,0,18,8" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Width" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Margin="0,0,28,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,28,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动与常驻" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="启动时自动连接" IsChecked="{Binding AutoConnect}" />
                        <CheckBox Content="开机自启（静默启动到托盘）" IsChecked="{Binding AutoStart}" />
                        <CheckBox Content="关闭窗口时最小化到托盘" IsChecked="{Binding CloseToTray}" IsEnabled="{Binding TrayAvailable}" />
                        <CheckBox Content="关闭到托盘时显示提示" IsChecked="{Binding NotifyOnClose}" />
                        <TextBlock Text="若托盘不可用，关闭窗口将直接退出。"
                                   Style="{StaticResource Label}" Margin="0,2,0,0" />
                        <TextBlock Text="全局快捷键：Ctrl+Alt+Shift+T 开始/暂停计时，Ctrl+Alt+H 显示/隐藏叠加层。"
                                   Style="{StaticResource Label}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="通知" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="房间成员进入 / 离开时发送系统通知"
                                  IsChecked="{Binding NotifyRoomEvents}" />
                        <CheckBox Content="房间聊天消息也显示系统通知"
                                  IsChecked="{Binding NotifyRoomChat}" Margin="0,6,0,0" />
                        <TextBlock Text="通知通过 Windows 通知中心显示；关闭后不再弹出。"
                                   Style="{StaticResource Label}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="共享当前窗口标题" IsChecked="{Binding ShareWindowTitles}" />
                        <TextBlock Text="窗口标题只在这个开关开启后上传；关闭时只显示应用名。"
                                   Style="{StaticResource Label}" Margin="0,2,0,8" />
                        <CheckBox Content="共享当前音乐状态" IsChecked="{Binding ShareMusic}" />
                        <TextBlock Text="只展示指定播放器的媒体；按播放器标识子串匹配，多个用英文逗号分隔，留空表示全部。"
                                   Style="{StaticResource Label}" Margin="0,6,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding MediaSourceFilter, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputBox}" Margin="0,0,0,2"
                                 ToolTip="例如：Spotify, QQMusic, 网易云" />
                        <TextBlock Text="例如：Spotify, QQMusic, 网易云"
                                   Style="{StaticResource Label}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="叠加层" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="显示屏幕叠加层" IsChecked="{Binding OverlayEnabled}" />
                        <CheckBox Content="点击穿透（不遮挡下方窗口）" IsChecked="{Binding OverlayClickThrough}" />

                        <TextBlock Text="预设样式" Style="{StaticResource Label}" Margin="0,4,0,5" />
                        <WrapPanel x:Name="PresetPanel" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="极简单行" Tag="minimal" GroupName="Preset" Checked="Preset_Checked" />
                            <RadioButton Content="紧凑双行" Tag="compact" GroupName="Preset" Checked="Preset_Checked" />
                            <RadioButton Content="卡片" Tag="card" GroupName="Preset" Checked="Preset_Checked" />
                            <RadioButton Content="字幕条" Tag="subtitle" GroupName="Preset" Checked="Preset_Checked" />
                            <RadioButton Content="自定义" Tag="custom" GroupName="Preset" Checked="Preset_Checked" />
                        </WrapPanel>

                        <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="{StaticResource RadiusSm}"
                                Padding="12" Margin="0,2,0,10">
                            <StackPanel>
                                <TextBlock Text="自定义主题" Style="{StaticResource Label}" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="字体" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="FontSummary" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="字体…" Click="ChooseFont_Click" Style="{StaticResource ModernButton}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="背景" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="BorderSummary" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="背景…" Click="ChooseBorder_Click" Style="{StaticResource ModernButton}" />
                                </StackPanel>

                                <Border x:Name="ThemePreview" HorizontalAlignment="Left" Margin="0,4,0,10"
                                        BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="ThemePreviewHeader" Text="房间 · 2 人在线"
                                                   FontSize="{StaticResource FontSizeXs}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ThemePreviewText" Text="{Binding MyStatusText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="应用自定义" Click="ApplyCustom_Click" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,8,6" />
                                    <Button Content="复制当前预设" Click="CopyPreset_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,6" />
                                    <Button Content="导出 JSON" Click="Export_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,6" />
                                    <Button Content="导入 JSON" Click="Import_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="重置叠加层位置" Click="ResetOverlay_Click"
                                Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,12,0,10" />
                        <TextBlock Text="叠加层显示房间内所有成员：在线优先，离线置灰；人数较多时可滚动。"
                                   Style="{StaticResource Label}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="版本" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="检查更新" Click="CheckUpdate_Click"
                                    Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                            <Button Content="下载更新" Click="DownloadUpdate_Click"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Label}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="配置文件" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SettingsPathText}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                        <Button Content="打开配置目录" Click="OpenSettingsFolder_Click"
                                Style="{StaticResource ModernButton}" HorizontalAlignment="Left" />
                        <TextBlock Text="日志目录" Style="{StaticResource Label}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding LogPathText}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                        <Button Content="打开日志目录" Click="OpenLogs_Click"
                                Style="{StaticResource ModernButton}" HorizontalAlignment="Left" />
                        <TextBlock Text="当前为未签名构建，Windows SmartScreen 可能提示未知发布者；自动更新尚未启用。"
                                   Style="{StaticResource Label}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
