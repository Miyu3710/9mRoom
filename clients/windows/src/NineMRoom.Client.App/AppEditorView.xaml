<UserControl x:Class="NineMRoom.Client.App.AppEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SectionGap" TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
      <Setter Property="Margin" Value="0,16,0,4" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="应用规则" Style="{DynamicResource M3TitleLarge}" VerticalAlignment="Center" />
      <controls:M3Button HorizontalAlignment="Right"
                         Style="{StaticResource M3IconButton}"
                         ToolTip="关闭（不保存）"
                         AutomationProperties.Name="关闭应用规则"
                         Click="Close_Click">
        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
      </controls:M3Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Style="{StaticResource M3PageScroll}">
      <StackPanel Margin="0,8,0,0">
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="56" Height="56" Margin="0,0,16,0">
            <Border CornerRadius="{StaticResource ShapeMedium}"
                    Background="{StaticResource BrushPrimaryContainer}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding AppDraft.HasIcon}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding AppDraft.Initial}"
                         Foreground="{StaticResource BrushOnPrimaryContainer}"
                         FontSize="{StaticResource TypeHeadlineSmallSize}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Image Source="{Binding AppDraft.Icon}" Width="56" Height="56"
                   Visibility="{Binding AppDraft.HasIcon, Converter={StaticResource BoolToVisibility}}" />
          </Grid>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppDraft.DisplayName}" Style="{StaticResource ItemTitle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AppDraft.AppId}" Style="{StaticResource ItemSupporting}"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="更换图标"
                             Click="CustomIcon_Click" />
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="恢复默认图标"
                             Margin="8,0,0,0" Click="ResetIcon_Click" />
        </StackPanel>

        <TextBox Text="{Binding AppDraft.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource M3TextBox}"
                 controls:M3Field.Label="显示名称"
                 VerticalAlignment="Top" />

        <TextBox Text="{Binding AppDraft.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource M3TextBox}"
                 controls:M3Field.Label="可执行文件路径"
                 VerticalAlignment="Top" />

        <TextBox Text="{Binding AppDraft.Template, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource M3TextBox}"
                 controls:M3Field.Label="状态模板"
                 VerticalAlignment="Top" />

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="例如：{app} · {title}"
                     Style="{StaticResource HintText}" VerticalAlignment="Center" />
          <controls:M3Button x:Name="TemplateHelpButton"
                             Style="{StaticResource M3IconButton}"
                             Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                             Margin="4,0,0,0"
                             ToolTip="查看可用占位符"
                             AutomationProperties.Name="查看可用占位符"
                             Click="Help_Click">
            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="14" Height="14"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
        </StackPanel>

        <Popup x:Name="TemplateHelpPopup" PlacementTarget="{Binding ElementName=TemplateHelpButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{StaticResource BrushSurfaceContainerHigh}"
                  BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                  CornerRadius="{StaticResource ShapeMedium}" Padding="16" Margin="0,6,0,0"
                  MaxWidth="420">
            <StackPanel>
              <TextBlock Text="可用占位符" Style="{StaticResource ItemTitle}" Margin="0,0,0,8" />
              <TextBlock Text="{}{app}  应用显示名" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{category}  应用分类" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{title}  媒体标题" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{artist}  艺术家" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{progress}  播放进度" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{remaining}  番茄剩余时间" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{todo}  当前待办文本" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{text}  自定义块文本" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
              <TextBlock Text="自定义块可用 ${...} 在本机执行命令。" Style="{StaticResource HintText}" />
            </StackPanel>
          </Border>
        </Popup>

        <ComboBox x:Name="CategoryBox"
                  Style="{StaticResource M3ComboBox}"
                  controls:M3Field.Label="应用分类"
                  SelectionChanged="CategoryBox_SelectionChanged"
                  AutomationProperties.Name="应用分类"
                  Margin="0,16,0,0"
                  VerticalAlignment="Top">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Style="{StaticResource M3CheckBox}"
                  Content="忽略此应用（不在状态中显示应用块）"
                  IsChecked="{Binding AppDraft.Ignored}"
                  Margin="0,16,0,0" />
        <CheckBox Style="{StaticResource M3CheckBox}"
                  Content="隐藏此应用的窗口标题"
                  IsChecked="{Binding AppDraft.HideTitle}"
                  Margin="0,4,0,0" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,28,0">
      <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="取消"
                         Click="Cancel_Click" />
      <controls:M3Button Style="{StaticResource M3FilledButton}" Content="保存"
                         Margin="8,0,0,0"
                         IsEnabled="{Binding IsAppRuleDirty}"
                         AutomationProperties.Name="保存应用规则"
                         Click="Save_Click" />
    </StackPanel>
  </Grid>
</UserControl>
