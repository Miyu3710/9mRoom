<UserControl x:Class="NineMRoom.Client.App.AppEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:CategoryMatchConverter x:Key="CategoryMatch" />
<Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="MinWidth" Value="44" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CategoryMatch}">
                            <Binding Path="DataContext.AppDraft.CategoryOverride"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="应用规则" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
            <Button Content="×" Click="Close_Click" HorizontalAlignment="Right"
                    Style="{StaticResource ModernButton}" Padding="10,3" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="56" Height="56">
                        <Border CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppDraft.HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AppDraft.Initial}" Foreground="{StaticResource BrushOnAccent}"
                                       FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding AppDraft.Icon}" Width="56" Height="56"
                               Visibility="{Binding AppDraft.HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                        <TextBlock Text="{Binding AppDraft.DisplayName}" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AppDraft.AppId}" Style="{StaticResource Label}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="更换图标" Click="CustomIcon_Click" Style="{StaticResource ModernButton}" Margin="0,0,6,0" />
                        <Button Content="恢复默认图标" Click="ResetIcon_Click" Style="{StaticResource ModernButton}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="显示名称" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox Text="{Binding AppDraft.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,0,12" />

                <TextBlock Text="文件位置" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox Text="{Binding AppDraft.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="状态模板（留空使用全局模板）" Style="{StaticResource Label}"
                               VerticalAlignment="Center" />
                    <Button x:Name="TemplateHelpButton" Content="?" Click="Help_Click"
                            Style="{StaticResource ModernButton}" Width="22" Height="20" Padding="0"
                            Margin="8,0,0,0" />

                    <Popup x:Name="TemplateHelpPopup" PlacementTarget="{Binding ElementName=TemplateHelpButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource BrushSurfaceAlt}"
                                BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,4,0,0">
                            <StackPanel MaxWidth="420">
                                <TextBlock Text="可用占位符" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{}{app}  应用显示名" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{category}  应用分类" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{title}  媒体标题" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{artist}  艺术家" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{progress}  播放进度" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{remaining}  番茄剩余时间" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{todo}  当前待办文本" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                <TextBlock Text="{}{text}  自定义块文本" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                <TextBlock Text="自定义块可用 ${...} 在本机执行命令。"
                                           Style="{StaticResource Label}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <TextBox Text="{Binding AppDraft.Template, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,0,14" />

                <TextBlock Text="应用分类" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="自动" Tag="" Click="Category_Click" Style="{StaticResource CategoryButton}" />
                    <ItemsControl ItemsSource="{Binding AppCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding Id}" Click="Category_Click"
                                        Style="{StaticResource CategoryButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <CheckBox Content="忽略此应用（不在状态中显示应用块）" IsChecked="{Binding AppDraft.Ignored}"
                          Margin="0,0,0,8" />
                <CheckBox Content="隐藏此应用的窗口标题" IsChecked="{Binding AppDraft.HideTitle}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Visibility="{Binding IsAppRuleDirty, Converter={StaticResource BoolToVisibility}}">
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
            <Button Content="保存" Click="Save_Click"
                    Style="{StaticResource ModernPrimaryButton}" />
        </StackPanel>
    </Grid>
</UserControl>
