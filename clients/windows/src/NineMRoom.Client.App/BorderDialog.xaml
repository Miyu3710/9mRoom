<Window x:Class="NineMRoom.Client.App.BorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        Title="背景与布局"
        Width="840" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" Background="{StaticResource BrushControlBg}"
                                    CornerRadius="3" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{StaticResource BrushAccent}"
                                                        CornerRadius="3" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource BrushText}"
                                                        BorderBrush="{StaticResource BrushAccent}"
                                                        BorderThickness="3" CornerRadius="8" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#17171A" BorderBrush="{StaticResource BrushGlassBorder}"
            BorderThickness="1" CornerRadius="12">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="背景与布局" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                <Button Content="×" Click="Cancel_Click" HorizontalAlignment="Right"
                        Style="{StaticResource ModernButton}" Padding="10,3" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                    <StackPanel>
                        <TextBlock Text="颜色" Style="{StaticResource Label}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="背景色" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <local:ColorPicker x:Name="BackgroundPicker" Width="175" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="文字色" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <local:ColorPicker x:Name="TextColorPicker" Width="175" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="次要色" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <local:ColorPicker x:Name="MutedColorPicker" Width="175" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="边框色" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <local:ColorPicker x:Name="BorderColorPicker" Width="175" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="背景不透明度" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Width="230"
                                    Style="{StaticResource ModernSlider}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpacityLabel" Grid.Column="1" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="圆角" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="RadiusBox" Style="{StaticResource ModernTextBox}" Width="58" Margin="0,0,14,6" />
                            <TextBlock Text="内边距" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="PaddingBox" Style="{StaticResource ModernTextBox}" Width="58" Margin="0,0,14,6" />
                            <TextBlock Text="宽度" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="WidthBox" Style="{StaticResource ModernTextBox}" Width="66" Margin="0,0,0,6" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="LayoutOne" Content="单行" GroupName="Layout" Margin="0,0,14,4" />
                            <RadioButton x:Name="LayoutTwo" Content="双行" GroupName="Layout" Margin="0,0,14,4" />
                            <RadioButton x:Name="PositionRight" Content="右下" GroupName="Position" Margin="0,0,14,4" />
                            <RadioButton x:Name="PositionCenter" Content="底部居中" GroupName="Position" Margin="0,0,0,4" />
                        </WrapPanel>

                        <CheckBox x:Name="ShowHeaderCheck" Content="显示房间标题" Margin="0,0,0,8" />
                        <CheckBox x:Name="WrapOneLineCheck" Content="单行过长时自动换行" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="预览" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <Border x:Name="PreviewBorder" Background="#D9232327" BorderBrush="#8034343A"
                            BorderThickness="1" CornerRadius="10" Padding="12"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" Text="demo · 1 人在线 · 专注中"
                                       Foreground="#9B9BA4" FontSize="10" Margin="0,0,0,6" />
                            <StackPanel x:Name="PreviewLines" Orientation="Horizontal">
                                <TextBlock x:Name="PreviewName" Text="朔月" />
                                <TextBlock x:Name="PreviewStatus" Text="endfield | 完成 9mRoom 待办"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                <Button Content="确定" Click="Ok_Click" Style="{StaticResource ModernPrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
