<Window x:Class="NineMRoom.Client.App.BorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="背景与布局"
        Width="900" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource BrushOnSurface}"
        FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Border Style="{StaticResource M3DialogSurface}" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="背景与布局" Style="{DynamicResource M3HeadlineSmall}" VerticalAlignment="Center" />
        <controls:M3Button HorizontalAlignment="Right"
                           Style="{StaticResource M3IconButton}"
                           ToolTip="关闭"
                           AutomationProperties.Name="关闭背景与布局"
                           Click="Cancel_Click">
          <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
          <StackPanel>
            <TextBlock Text="颜色" Style="{StaticResource ItemSupporting}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                <TextBlock Text="背景色" Style="{StaticResource ItemSupporting}" Margin="0,0,0,4" />
                <local:ColorPicker x:Name="BackgroundPicker" Width="180" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                <TextBlock Text="文字色" Style="{StaticResource ItemSupporting}" Margin="0,0,0,4" />
                <local:ColorPicker x:Name="TextColorPicker" Width="180" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="次要色" Style="{StaticResource ItemSupporting}" Margin="0,0,0,4" />
                <local:ColorPicker x:Name="MutedColorPicker" Width="180" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="边框色" Style="{StaticResource ItemSupporting}" Margin="0,0,0,4" />
                <local:ColorPicker x:Name="BorderColorPicker" Width="180" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>

            <TextBlock Text="背景不透明度" Style="{StaticResource ItemSupporting}" Margin="0,12,0,4" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100"
                      VerticalAlignment="Center" Width="240" HorizontalAlignment="Left" />
              <TextBlock x:Name="OpacityLabel" Grid.Column="1" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="RadiusBox" Grid.Column="0" Style="{StaticResource M3TextBoxCompact}"
                       controls:M3Field.Label="圆角" Margin="0,0,8,0" VerticalAlignment="Top" />
              <TextBox x:Name="PaddingBox" Grid.Column="1" Style="{StaticResource M3TextBoxCompact}"
                       controls:M3Field.Label="内边距" Margin="0,0,8,0" VerticalAlignment="Top" />
              <TextBox x:Name="WidthBox" Grid.Column="2" Style="{StaticResource M3TextBoxCompact}"
                       controls:M3Field.Label="宽度" VerticalAlignment="Top" />
            </Grid>

            <TextBlock Text="布局" Style="{StaticResource ItemSupporting}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <RadioButton x:Name="LayoutOne" Content="单行" GroupName="Layout" Margin="0,0,20,0" />
              <RadioButton x:Name="LayoutTwo" Content="双行" GroupName="Layout" />
            </StackPanel>

            <TextBlock Text="位置" Style="{StaticResource ItemSupporting}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <RadioButton x:Name="PositionRight" Content="右下" GroupName="Position" Margin="0,0,20,0" />
              <RadioButton x:Name="PositionCenter" Content="底部居中" GroupName="Position" />
            </StackPanel>

            <CheckBox x:Name="ShowHeaderCheck" Style="{StaticResource M3CheckBox}"
                      Content="显示房间标题" Margin="0,12,0,0" />
            <CheckBox x:Name="WrapOneLineCheck" Style="{StaticResource M3CheckBox}"
                      Content="单行过长时自动换行" />
            <TextBlock Text="这些选项在点击「确定」后一次性生效。"
                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1">
          <TextBlock Text="预览" Style="{StaticResource ItemSupporting}" Margin="0,0,0,8" />
          <Border x:Name="PreviewBorder" Background="#D9232327" BorderBrush="#8034343A"
                  BorderThickness="1" CornerRadius="10" Padding="12"
                  HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock x:Name="PreviewTitle" Text="demo · 1 人在线 · 专注中"
                         Foreground="#9B9BA4" FontSize="10" Margin="0,0,0,6" />
              <StackPanel x:Name="PreviewLines" Orientation="Horizontal">
                <TextBlock x:Name="PreviewName" Text="朔月" Foreground="#ECECF0" />
                <TextBlock x:Name="PreviewStatus" Text="endfield | 完成 9mRoom 待办"
                           Margin="8,0,0,0" Foreground="#ECECF0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="预览仅用于观察对比度与尺寸，不进入房间状态。"
                     Style="{StaticResource HintText}" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="取消" Click="Cancel_Click" />
        <controls:M3Button Style="{StaticResource M3TextButton}" Content="确定" Margin="8,0,0,0" Click="Ok_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
