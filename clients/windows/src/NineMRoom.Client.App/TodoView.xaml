<UserControl x:Class="NineMRoom.Client.App.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,16">
            <TextBlock Text="待办" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTodoBox" Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                     KeyDown="NewTodo_KeyDown" />
                            <Button Grid.Column="1" Content="添加待办" Click="AddTodo_Click"
                                    Style="{StaticResource ModernPrimaryButton}" />
                        </Grid>
                        <TextBlock Text="还没有待办。输入标题后回车或点“添加待办”。"
                                   Style="{StaticResource Label}" Margin="0,10,0,0"
                                   Visibility="{Binding IsTodoEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Todos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" FontSize="{StaticResource FontSizeMd}" />
                                        <Button Grid.Column="2" Content="{Binding PinLabel}" Tag="{Binding}"
                                                Click="Pin_Click" Style="{StaticResource ModernButton}" Margin="8,0,4,0" />
                                        <Button Grid.Column="3" Content="×" Tag="{Binding}"
                                                Click="RemoveTodo_Click" Style="{StaticResource ModernButton}" Padding="9,4" />
                                    </Grid>

                                    <TextBlock Text="{Binding ProgressText, StringFormat=子任务 {0}}" Style="{StaticResource Label}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}" />

                                    <ItemsControl ItemsSource="{Binding Subtasks}" Margin="28,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputBox}" />
                                                    <Button Grid.Column="2" Content="×" Tag="{Binding}"
                                                            Click="RemoveSubtask_Click" Style="{StaticResource ModernButton}"
                                                            Padding="8,3" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="＋ 子任务" Tag="{Binding}" Click="AddSubtask_Click"
                                            Style="{StaticResource ModernButton}" HorizontalAlignment="Left"
                                            Margin="28,2,0,0" Padding="8,3" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="开始" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" ToolTip="可选，例如 10-22 14:00" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="结束" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="3" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" ToolTip="可选，例如 10-22 16:00" />
                                    </Grid>
                                    <TextBlock Text="起止时间只在本机显示，不会进入状态块。"
                                               Style="{StaticResource Label}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
