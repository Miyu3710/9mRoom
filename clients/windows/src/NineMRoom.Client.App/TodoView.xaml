<UserControl x:Class="NineMRoom.Client.App.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NineMRoom.Client.App"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBooleanConverter x:Key="Not" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,28,16">
      <TextBlock Text="待办" Style="{StaticResource PageTitle}" />
      <TextBlock Text="列表默认展示文本；需要修改时从行尾菜单进入编辑态。变更会立即保存。"
                 Style="{StaticResource PageSupporting}" />
    </StackPanel>

    <!-- 创建：输入字段 + 唯一主操作 -->
    <Grid Grid.Row="1" Margin="0,0,28,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="NewTodoBox"
               Grid.Column="0"
               Style="{StaticResource M3TextBox}"
               controls:M3Field.Label="新待办"
               controls:M3Field.HelperText="回车或点击「添加」创建；标题之后可再加子任务与时间。"
               KeyDown="NewTodo_KeyDown"
               Margin="0,0,12,0"
               VerticalAlignment="Top" />
      <controls:M3Button Grid.Column="1"
                         Style="{StaticResource M3FilledButton}"
                         Content="添加"
                         AutomationProperties.Name="添加待办"
                         VerticalAlignment="Top"
                         Margin="0,8,0,0"
                         Click="AddTodo_Click" />
    </Grid>

    <ScrollViewer Grid.Row="2" Style="{StaticResource M3PageScroll}" Margin="0,8,0,0">
      <StackPanel>

        <TextBlock Text="还没有待办。先添加第一条，专注时它会显示在房间里。"
                   Margin="0,8,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTodoEmpty}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Todos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
                <Grid Margin="0,12,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Column="0"
                            Style="{StaticResource M3CheckBox}"
                            IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                            AutomationProperties.Name="标记待办完成"
                            VerticalAlignment="Top"
                            Margin="0,0,8,0" />

                  <!-- 展示态 -->
                  <StackPanel Grid.Column="1" Margin="0,4,12,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding Title}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource M3BodyLarge}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                              <Setter Property="TextDecorations">
                                <Setter.Value>
                                  <TextDecorationCollection>
                                    <TextDecoration Location="Strikethrough" />
                                  </TextDecorationCollection>
                                </Setter.Value>
                              </Setter>
                              <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ProgressText, StringFormat=子任务 {0}}"
                               Style="{StaticResource ItemSupporting}" Margin="0,2,0,0"
                               Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Margin="0,2,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StartTime}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                      <Run Text="{Binding StartTime, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding EndTime, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <!-- 编辑态：字段、子任务、时间 -->
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>

                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource M3TextBox}"
                             controls:M3Field.Label="待办标题" />
                    <ItemsControl ItemsSource="{Binding Subtasks}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource M3CheckBox}"
                                      IsChecked="{Binding IsDone, Mode=TwoWay}"
                                      AutomationProperties.Name="标记子任务完成"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource M3TextBoxCompact}"
                                     controls:M3Field.Label="子任务"
                                     Margin="0,0,8,0" />
                            <controls:M3Button Grid.Column="2"
                                               Style="{StaticResource M3IconButton}"
                                               ToolTip="删除子任务"
                                               AutomationProperties.Name="删除子任务"
                                               Tag="{Binding}"
                                               VerticalAlignment="Center"
                                               Click="RemoveSubtask_Click">
                              <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                            </controls:M3Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:M3Button Style="{StaticResource M3TextButtonNeutral}"
                                       Content="＋ 添加子任务"
                                       HorizontalAlignment="Left"
                                       Margin="0,2,0,0"
                                       Tag="{Binding}"
                                       Click="AddSubtask_Click" />

                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource M3TextBoxCompact}"
                                 controls:M3Field.Label="开始时间"
                                 controls:M3Field.HelperText="例如 10-22 14:00，可留空"
                                 VerticalAlignment="Top">
                          <TextBox.Text>
                            <Binding Path="StartTime" UpdateSourceTrigger="LostFocus">
                              <Binding.ValidationRules>
                                <controls:TimeTextValidationRule />
                              </Binding.ValidationRules>
                            </Binding>
                          </TextBox.Text>
                        </TextBox>
                        <controls:M3Button Grid.Column="1"
                                           Style="{StaticResource M3IconButton}"
                                           ToolTip="选择开始日期与时间"
                                           AutomationProperties.Name="选择开始日期与时间"
                                           Tag="{Binding}"
                                           VerticalAlignment="Top"
                                           Margin="4,8,0,0"
                                           Click="PickStartTime_Click">
                          <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                        </controls:M3Button>
                      </Grid>

                      <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource M3TextBoxCompact}"
                                 controls:M3Field.Label="结束时间"
                                 controls:M3Field.HelperText="例如 10-22 16:00，可留空"
                                 VerticalAlignment="Top">
                          <TextBox.Text>
                            <Binding Path="EndTime" UpdateSourceTrigger="LostFocus">
                              <Binding.ValidationRules>
                                <controls:TimeTextValidationRule />
                              </Binding.ValidationRules>
                            </Binding>
                          </TextBox.Text>
                        </TextBox>
                        <controls:M3Button Grid.Column="1"
                                           Style="{StaticResource M3IconButton}"
                                           ToolTip="选择结束日期与时间"
                                           AutomationProperties.Name="选择结束日期与时间"
                                           Tag="{Binding}"
                                           VerticalAlignment="Top"
                                           Margin="4,8,0,0"
                                           Click="PickEndTime_Click">
                          <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                        </controls:M3Button>
                      </Grid>
                    </Grid>
                    <TextBlock Text="起止时间只在本机显示，不会进入状态块。"
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />

                    <controls:M3Button Style="{StaticResource M3TextButton}"
                                       Content="完成编辑"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0"
                                       Tag="{Binding}"
                                       Click="DoneEdit_Click" />
                  </StackPanel>

                  <ToggleButton Grid.Column="2"
                                Style="{StaticResource M3IconToggleButton}"
                                IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                IsEnabled="{Binding IsEditing, Converter={StaticResource Not}}"
                                ToolTip="置顶 / 取消置顶"
                                AutomationProperties.Name="置顶或取消置顶"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0">
                    <materialDesign:PackIcon Kind="PinOutline" Width="18" Height="18"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                  </ToggleButton>

                  <controls:M3Button Grid.Column="3"
                                     Style="{StaticResource M3IconButton}"
                                     ToolTip="更多操作"
                                     AutomationProperties.Name="待办更多操作"
                                     VerticalAlignment="Top"
                                     Margin="0,2,0,0"
                                     Click="TodoMenu_Click">
                    <controls:M3Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="编辑" Tag="{Binding}" Click="EditTodo_Click">
                          <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding PinLabel}" Tag="{Binding}" Click="Pin_Click">
                          <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="PinOutline" Width="18" Height="18" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除待办" Tag="{Binding}" Click="RemoveTodo_Click"
                                  Foreground="{StaticResource BrushError}">
                          <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource BrushError}" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </controls:M3Button.ContextMenu>
                    <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                  </controls:M3Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
