<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- M3 linear progress: 4dp, rounded, primary active range. -->
  <Style x:Key="M3LinearProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Background" Value="{DynamicResource BrushSecondaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid Background="Transparent" VerticalAlignment="Center">
            <Border x:Name="PART_Track"
                    Height="4"
                    CornerRadius="2"
                    Background="{TemplateBinding Background}" />
            <Border x:Name="PART_Indicator"
                    Height="4"
                    CornerRadius="2"
                    Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left" />
            <Border x:Name="IndeterminateBand"
                    Height="4"
                    Width="120"
                    CornerRadius="2"
                    Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <TranslateTransform x:Name="IndeterminateTransform" X="-120" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="IndeterminateBand" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="IndeterminateSweep">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                     Storyboard.TargetProperty="X"
                                     From="-120" To="900" Duration="0:0:1.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <RemoveStoryboard BeginStoryboardName="IndeterminateSweep" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ProgressBar" BasedOn="{StaticResource M3LinearProgress}" />

  <!-- Persistent, non-transient system banner (error container role). -->
  <Style x:Key="M3BannerError" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrushErrorContainer}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShapeSmall}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="M3BannerText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnErrorContainer}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
