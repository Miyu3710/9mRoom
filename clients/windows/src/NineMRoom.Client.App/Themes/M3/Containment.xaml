<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NineMRoom.Client.App"
                    xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls">

  <!--
    M3 containment: cards (only where content is a self-contained entity),
    lists, dividers, menus, tooltips, side sheets, scrollbars.
    Cards are NOT the default container.
  -->

  <Style x:Key="M3CardFilled" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerHighest}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShapeMedium}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="M3CardOutlined" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushOutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShapeMedium}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- 12dp radius, tonal surface: used for the sync-list preview only. -->
  <Style x:Key="M3PreviewSurface" TargetType="Border" BasedOn="{StaticResource M3CardOutlined}">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerLow}" />
    <Setter Property="Padding" Value="16,12" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="M3Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BrushOutlineVariant}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="M3ListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="{DynamicResource SizeListOneLine}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="controls:Ripple.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="SelectedSurface"
                    Background="{DynamicResource BrushSecondaryContainer}"
                    Visibility="Collapsed" />
            <Border x:Name="HoverLayer"
                    Background="{TemplateBinding Foreground}"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <Canvas x:Name="RippleHost" IsHitTestVisible="False" ClipToBounds="True" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource BrushPrimary}"
                    BorderThickness="2"
                    Margin="2"
                    CornerRadius="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverLayer" Property="Opacity" Value="{DynamicResource StateHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedSurface" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource BrushOnSecondaryContainer}" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem" BasedOn="{StaticResource M3ListItem}" />

  <Style x:Key="M3ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer Focusable="False"
                          Padding="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox" BasedOn="{StaticResource M3ListBox}" />

  <!-- Side sheet (desktop): surfaceContainerLow, 16dp leading corners, scrim 32%. -->
  <Style x:Key="M3SideSheet" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerLow}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16,0,0,16" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style x:Key="M3DialogSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerHigh}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShapeExtraLarge}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- M3 menu (flat items; submenus are not used in 9mRoom). -->
  <Style x:Key="M3MenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:Ripple.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid Background="Transparent" MinHeight="48">
            <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" />
            <Canvas x:Name="RippleHost" IsHitTestVisible="False" ClipToBounds="True" />
            <Grid Margin="12,0,16,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0"
                                ContentSource="Icon"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
              <ContentPresenter Grid.Column="1"
                                ContentSource="Header"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
              <TextBlock Grid.Column="2"
                         Text="{TemplateBinding InputGestureText}"
                         Foreground="{DynamicResource BrushOnSurfaceVariant}"
                         FontSize="{DynamicResource TypeBodySmallSize}"
                         Margin="24,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="{DynamicResource StateHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem" BasedOn="{StaticResource M3MenuItem}" />

  <Style x:Key="M3ContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BrushOutlineVariant}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ShapeExtraSmall}"
                  Padding="0,8"
                  MinWidth="180"
                  Margin="0,4,0,0">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu" BasedOn="{StaticResource M3ContextMenu}" />

  <!-- Plain tooltip: short hint only, never the sole source of critical information. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource BrushInverseSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushInverseOnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodySmallSize}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource ShapeExtraSmall}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin scrollbars with M3 outline colors. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,4,4,4" />
    <Setter Property="Width" Value="{DynamicResource SizeScrollBar}" />
    <Setter Property="MinWidth" Value="{DynamicResource SizeScrollBar}" />
    <Setter Property="MaxWidth" Value="{DynamicResource SizeScrollBar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbBar" Background="{DynamicResource BrushOutline}"
                              Opacity="0.6" CornerRadius="2" Width="4" HorizontalAlignment="Center" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBar" Property="Opacity" Value="1" />
                          <Setter TargetName="ThumbBar" Property="Width" Value="6" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Margin" Value="4,0,4,4" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="Infinity" />
        <Setter Property="Height" Value="{DynamicResource SizeScrollBar}" />
        <Setter Property="MinHeight" Value="{DynamicResource SizeScrollBar}" />
        <Setter Property="MaxHeight" Value="{DynamicResource SizeScrollBar}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="ThumbBar" Background="{DynamicResource BrushOutline}"
                                  Opacity="0.6" CornerRadius="2" Height="4" VerticalAlignment="Center" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ThumbBar" Property="Opacity" Value="1" />
                              <Setter TargetName="ThumbBar" Property="Height" Value="6" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="local:SmoothScroll.IsEnabled" Value="True" />
    <Setter Property="local:ScrollFade.IsEnabled" Value="True" />
  </Style>

  <!-- Page-level scroller: scrollbar hugs the window edge, content keeps a gutter. -->
  <Style x:Key="M3PageScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
    <Setter Property="Padding" Value="0,0,28,0" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

</ResourceDictionary>
