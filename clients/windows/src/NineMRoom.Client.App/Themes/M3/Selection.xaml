<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
                    xmlns:local="clr-namespace:NineMRoom.Client.App">

  <!--
    M3 selection controls. Radio = one of a set with explanation; Checkbox = independent
    conditions submitted together; Switch = setting that applies immediately;
    Segmented button = compact single-select among 2-5 options.
  -->

  <Style x:Key="M3RadioButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Center">
              <Ellipse x:Name="StateLayer" Fill="{TemplateBinding Foreground}" Opacity="0" />
              <Ellipse x:Name="Ring" Width="20" Height="20"
                       Stroke="{DynamicResource BrushOnSurfaceVariant}" StrokeThickness="2" />
              <Ellipse x:Name="Dot" Width="10" Height="10"
                       Fill="{DynamicResource BrushPrimary}" Visibility="Collapsed" />
              <Ellipse x:Name="FocusRing" Width="30" Height="30"
                       Stroke="{DynamicResource BrushPrimary}" StrokeThickness="3"
                       Visibility="Collapsed" />
            </Grid>

            <ContentPresenter Grid.Column="1"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="Normal" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="{DynamicResource StateHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton" BasedOn="{StaticResource M3RadioButton}" />

  <Style x:Key="M3CheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Top">
              <Border x:Name="StateLayer" Width="40" Height="40" CornerRadius="20"
                      Background="{TemplateBinding Foreground}" Opacity="0" />
              <Ellipse x:Name="PressRipple" Width="40" Height="40"
                       Fill="{TemplateBinding Foreground}" Opacity="0"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="{DynamicResource ShapeExtraSmall}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BrushOnSurfaceVariant}"
                      BorderThickness="2"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform />
                </Border.RenderTransform>
              </Border>
              <Path x:Name="CheckMark" Width="14" Height="14" Stretch="Uniform"
                    Data="M 1,7 L 5,11 L 13,2"
                    Stroke="{DynamicResource BrushOnPrimary}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                </Path.RenderTransform>
              </Path>
              <Rectangle x:Name="Dash" Width="10" Height="2"
                         Fill="{DynamicResource BrushOnPrimary}" Visibility="Collapsed" />
              <Border x:Name="FocusRing" Width="30" Height="30" CornerRadius="8"
                      BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="3"
                      Visibility="Collapsed" />
            </Grid>

            <ContentPresenter Grid.Column="1"
                              Margin="0,10,0,10"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="{DynamicResource StateHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="CheckMark"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="CheckMark"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="Box"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.9" To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="Box"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.9" To="1" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="CheckMark"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.6" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="CheckMark"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.6" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
            </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource M3CheckBox}" />

  <!-- Switch: label on the leading edge, 52x32 track on the trailing edge. Applies immediately. -->
  <Style x:Key="M3Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodyMediumSize}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentPresenter VerticalAlignment="Center"
                              Margin="0,8,16,8"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}" />

            <Grid x:Name="SwitchRoot" Grid.Column="1" Width="52" Height="48" VerticalAlignment="Center">
              <Grid.Effect>
                <DropShadowEffect Color="{StaticResource ColorPrimary}" ShadowDepth="0" BlurRadius="16" Opacity="0" />
              </Grid.Effect>
              <Border x:Name="StateLayer" Width="52" Height="40" CornerRadius="20"
                      Background="{TemplateBinding Foreground}" Opacity="0" />
              <Border x:Name="Track" Width="52" Height="32" CornerRadius="16"
                      Background="{DynamicResource BrushSurfaceContainerHighest}"
                      BorderThickness="0" />
              <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12"
                      Background="{DynamicResource BrushOnSurfaceVariant}"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="4,0,0,0">
                <Path x:Name="ThumbCheck"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M 1,5 L 4,8 L 9,1"
                      Stroke="{DynamicResource BrushPrimary}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                  </Path.RenderTransform>
                </Path>
              </Border>
              <Border x:Name="FocusRing" Width="58" Height="38" CornerRadius="19"
                      BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="3"
                      Visibility="Collapsed" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SwitchRoot"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     To="0.55" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SwitchRoot"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     To="0" Duration="0:0:0.26">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
              <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource BrushOnPrimary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin"
                                        To="24,0,0,0" Duration="0:0:0.18">
                      <ThicknessAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.14" BeginTime="0:0:0.05" />
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.16" BeginTime="0:0:0.05" />
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.16" BeginTime="0:0:0.05" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin"
                                        To="4,0,0,0" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.6" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="ThumbCheck"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.6" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented button (single-select). Position controls the outer corners. -->
  <Style x:Key="M3SegmentedButton" TargetType="{x:Type controls:M3SegmentedButton}">
    <Setter Property="controls:Ripple.IsEnabled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeLabelLargeSize}" />
    <Setter Property="Height" Value="{DynamicResource SizeButton}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="0,0,-1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:M3SegmentedButton.CornerRadius" Value="{DynamicResource ShapeSmall}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:M3SegmentedButton}">
          <Grid>
            <Border x:Name="Segment"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BrushOutline}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="StateLayer"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <Canvas x:Name="RippleHost" IsHitTestVisible="False" ClipToBounds="True" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}">
                  <Path x:Name="CheckIcon"
                        Width="14" Height="14" Stretch="Uniform"
                        Data="M 1,7 L 5,11 L 13,2"
                        Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="Collapsed" />
                  <ContentPresenter VerticalAlignment="Center"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.FontWeight="Medium"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{DynamicResource TypeLabelLargeSize}" />
                        <Setter Property="FontWeight" Value="{DynamicResource TypeLabelLargeWeight}" />
                        <Setter Property="LineHeight" Value="{DynamicResource TypeLabelLargeLine}" />
                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                      </Style>
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{DynamicResource BrushPrimary}"
                    BorderThickness="3"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="StateLayer" Storyboard.TargetProperty="Opacity"
                                     To="0.08" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="StateLayer" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource BrushSecondaryContainer}" />
              <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource BrushSecondaryContainer}" />
              <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource BrushOnSecondaryContainer}" />
              <Setter Property="Panel.ZIndex" Value="2" />
            </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Position" Value="First">
        <Setter Property="controls:M3SegmentedButton.CornerRadius" Value="8,0,0,8" />
      </Trigger>
      <Trigger Property="Position" Value="Middle">
        <Setter Property="controls:M3SegmentedButton.CornerRadius" Value="0" />
        <Setter Property="Margin" Value="-1,0,-1,0" />
      </Trigger>
      <Trigger Property="Position" Value="Last">
        <Setter Property="controls:M3SegmentedButton.CornerRadius" Value="0,8,8,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type controls:M3SegmentedButton}" BasedOn="{StaticResource M3SegmentedButton}" />

  <!-- Toggle icon button: used for the "pin" state of a todo row. -->
  <Style x:Key="M3IconToggleButton" TargetType="ToggleButton">
    <Setter Property="Width" Value="{DynamicResource SizeIconButton}" />
    <Setter Property="Height" Value="{DynamicResource SizeIconButton}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShapeSmall}">
              <Grid>
                <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}"
                        CornerRadius="{DynamicResource ShapeSmall}" Opacity="0" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource BrushPrimary}"
                    BorderThickness="3" CornerRadius="{DynamicResource ShapeSmall}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="{DynamicResource StateHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSecondaryContainer}" />
              <Setter Property="Foreground" Value="{DynamicResource BrushOnSecondaryContainer}" />
            </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding Cue, Source={x:Static local:InputMode.Instance}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource StateDisabledContent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
