<UserControl x:Class="NineMRoom.Client.App.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,16">
            <TextBlock Text="专注" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="今日" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding TodayFocusText}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
                        <ProgressBar Value="{Binding GoalPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8" />
                        <TextBlock Text="{Binding GoalProgressText}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StreakText}" Style="{StaticResource Label}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding WeekFocusText, StringFormat=近 7 天合计：{0}}"
                                   Style="{StaticResource Label}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="番茄计时" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding TimerText}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="开始" Click="TimerStart_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,6" />
                            <Button Content="暂停" Click="TimerPause_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,6" />
                            <Button Content="重置" Click="TimerReset_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="25 分" Tag="25" Click="TimerMinutes_Click" Style="{StaticResource ActionButton}" Padding="10,5" Margin="0,0,6,6" />
                            <Button Content="45 分" Tag="45" Click="TimerMinutes_Click" Style="{StaticResource ActionButton}" Padding="10,5" Margin="0,0,6,6" />
                            <Button Content="60 分" Tag="60" Click="TimerMinutes_Click" Style="{StaticResource ActionButton}" Padding="10,5" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="统计设置" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="记录专注统计（仅本机，可随时关闭）" IsChecked="{Binding StatsEnabled}" />
                        <TextBlock Text="每日目标（分钟，0 为关闭）" Style="{StaticResource Label}" Margin="0,6,0,4" />
                        <TextBox Text="{Binding DailyGoalMinutes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputBox}" Width="100" Height="34" HorizontalAlignment="Left" />

                        <TextBlock Text="近 7 天" Style="{StaticResource Label}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding FocusHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" />
                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource Label}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="统计只保存在本机；房间内仅同步今日总秒数。"
                                   Style="{StaticResource Label}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
