<UserControl x:Class="NineMRoom.Client.App.FontPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="FontBox" Style="{StaticResource InputBox}" FontSize="{StaticResource FontSizeSm}" />
        <Button Grid.Column="1" Click="OpenList_Click" Width="32" Height="32" Margin="4,0,0,0"
                Style="{StaticResource MaterialDesignIconButton}" ToolTip="选择字体">
            <materialDesign:PackIcon Kind="FormatFont" Width="18" Height="18" />
        </Button>

        <Popup x:Name="FontPopup" PlacementTarget="{Binding ElementName=FontBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource BrushSurfaceAlt}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0"
                    CornerRadius="{StaticResource RadiusMd}" Padding="4" Margin="0,4,0,0">
                <ListBox x:Name="FontList" Width="260" Height="280"
                         Background="Transparent"
                         Foreground="{StaticResource BrushText}"
                         BorderThickness="0"
                         SelectionChanged="FontList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="{StaticResource FontSizeSm}"
                                       Padding="6,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
