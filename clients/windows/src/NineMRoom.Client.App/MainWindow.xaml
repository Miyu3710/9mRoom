<Window x:Class="NineMRoom.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="9mRoom"
        Width="{StaticResource LayoutWindowWidth}"
        Height="{StaticResource LayoutWindowHeight}"
        MinWidth="900"
        MinHeight="560"
        WindowStyle="None"
        Background="#01000000"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushControlHover}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushDanger}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <local:CategoryMatchConverter x:Key="ModeMatch" />

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ModeMatch}">
                            <Binding Path="ManualMode" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="{StaticResource RadiusMd}" Padding="10,9">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource BrushAccent}"
                                        CornerRadius="2" Visibility="Collapsed" />
                                <ContentPresenter Margin="10,0,0,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoomTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBg" Background="Transparent"
                                CornerRadius="{StaticResource RadiusPill}" Padding="14,7">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{StaticResource BrushControlHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            BorderBrush="{StaticResource BrushGlassBorder}"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C42E2E36" Offset="0" />
                <GradientStop Color="#B818181D" Offset="0.55" />
                <GradientStop Color="#C4212128" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/9mRoom-mark.png" Height="18" Width="28"
                           Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="9mRoom" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold" />
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom" Background="#1AFFFFFF" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" />
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0"
                Background="#3D1B1B21"
                BorderBrush="{StaticResource BrushGlassBorder}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,18,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <RadioButton x:Name="RoomNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" IsChecked="True" Checked="RoomNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="自习室" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FocusNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="FocusNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="专注" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TodoNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="TodoNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="待办" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LayoutNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="LayoutNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="状态" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AppNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="AppNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="应用" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="设置" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="1" Background="#2BFFFFFF" CornerRadius="{StaticResource RadiusMd}"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Label}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText, StringFormat=v{0}}" Style="{StaticResource Label}"
                                   FontSize="{StaticResource FontSizeXs}" Margin="14,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Margin="28,26,0,24">
            <Grid x:Name="RoomPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,28,18">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="自习室" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,24,10">
                    <RadioButton x:Name="StateTabButton" Content="状态" GroupName="RoomTabs"
                                 Style="{StaticResource RoomTab}" IsChecked="True" Checked="StateTab_Checked" />
                    <RadioButton x:Name="RoomTabButton" Content="房间" GroupName="RoomTabs"
                                 Style="{StaticResource RoomTab}" Checked="RoomTab_Checked" />
                    <RadioButton x:Name="LogTabButton" Content="日志" GroupName="RoomTabs"
                                 Style="{StaticResource RoomTab}" Checked="LogTab_Checked" />
                    <RadioButton x:Name="ChatTabButton" Content="聊天" GroupName="RoomTabs"
                                 Style="{StaticResource RoomTab}" Checked="ChatTab_Checked" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" x:Name="StateTabContent"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,24,0">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Text="服务器" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerBase, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10" />

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="10,0,0,10">
                                        <Button Content="{Binding ConnectButtonText}" Click="Connect_Click"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                        <Button Content="离开房间" Click="LeaveRoom_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource BrushBreak}"
                                           FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoticeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                                <TextBlock Text="我的状态" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MyStatusText}" Style="{StaticResource Body}" Margin="0,10,0,0" />

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="自动" Tag="auto" Click="Mode_Click" Style="{StaticResource ModeButton}" Padding="8,4" Margin="0,0,4,4" />
                                    <Button Content="专注" Tag="focusing" Click="Mode_Click" Style="{StaticResource ModeButton}" Padding="8,4" Margin="0,0,4,4" />
                                    <Button Content="休息" Tag="break" Click="Mode_Click" Style="{StaticResource ModeButton}" Padding="8,4" Margin="0,0,4,4" />
                                    <Button Content="离开" Tag="away" Click="Mode_Click" Style="{StaticResource ModeButton}" Padding="8,4" Margin="0,0,4,4" />
                                    <Button Content="隐身" Tag="invisible" Click="Mode_Click" Style="{StaticResource ModeButton}" Padding="8,4" Margin="0,0,4,4" />
                                </WrapPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前待办" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveTodoText}" Style="{StaticResource Body}" />
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="应用" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyAppText}" Style="{StaticResource Body}" Margin="0,2,0,10" />
                                        <TextBlock Text="空闲" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyIdleText}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="音乐" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyMediaText}" Style="{StaticResource Body}" Margin="0,2,0,10" />
                                        <TextBlock Text="同步" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" x:Name="RoomTabContent" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="你未进入房间" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="连接服务器后，加入一个房间开始自习。" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" Margin="0,8,0,16" />
                        <Button Content="加入房间" Click="OpenJoin_Click" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                    <StackPanel Margin="0,0,24,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoomDisplayName}"
                                               FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                               Cursor="Hand" ToolTip="点击复制房间码"
                                               MouseLeftButtonUp="RoomName_Click" />
                                    <TextBlock Text="点击房间名复制房间码"
                                               Style="{StaticResource Label}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding RoomCodeNotice}" Style="{StaticResource Label}"
                                               Foreground="{StaticResource BrushAccent}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemberCountText}" Style="{StaticResource Label}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>

                            <TextBlock Text="房间成员" Style="{StaticResource Label}"
                                       DockPanel.Dock="Top" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                                    MouseLeftButtonUp="MemberRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}"
                                                            Background="{StaticResource BrushAccent}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="{StaticResource BrushOnAccent}"
                                                                   FontSize="{StaticResource FontSizeLg}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                                                            <Border Background="{StaticResource BrushSurface}" CornerRadius="{StaticResource RadiusSm}"
                                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Label}" FontSize="{StaticResource FontSizeXs}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Label}"
                                                                   FontSize="{StaticResource FontSizeXs}" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasWindowTitle, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding AgoText}" Style="{StaticResource Label}" FontSize="{StaticResource FontSizeXs}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" x:Name="LogTabContent" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,24,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RoomLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Label}"
                                                       FontSize="{StaticResource FontSizeXs}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}"
                                                       FontSize="{StaticResource FontSizeSm}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" x:Name="ChatTabContent" Visibility="Collapsed">
                    <local:ChatPanel Margin="0,0,24,0" />
                </Grid>
            </Grid>

            <local:FocusView x:Name="FocusPage" Visibility="Collapsed" />

            <local:TodoView x:Name="TodoPage" Visibility="Collapsed" />

            <local:LayoutView x:Name="LayoutPage" Visibility="Collapsed" />

            <local:AppView x:Name="AppPage" Visibility="Collapsed" />

            <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="MemberDrawerOverlay" Grid.ColumnSpan="2"
              Background="#99000000" Opacity="0" Visibility="Collapsed"
              MouseLeftButtonDown="MemberDrawerOverlay_MouseLeftButtonDown">
            <Border x:Name="MemberDrawerPanel" Width="400" HorizontalAlignment="Right"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1,0,0,0"
                    Padding="22">
                <Border.RenderTransform>
                    <TranslateTransform X="400" />
                </Border.RenderTransform>
                <StackPanel DataContext="{Binding SelectedMember}">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="成员详情" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                        <Button Content="×" Click="CloseDrawer_Click" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}"
                                Background="{StaticResource BrushAccent}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Initial}" Foreground="{StaticResource BrushOnAccent}"
                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Label}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="戳一下" Click="PokeMember_Click"
                                Style="{StaticResource PrimaryButton}" Padding="14,6"
                                FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Visibility="{Binding CanPoke, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBlock Text="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{StaticResource BrushAccent}" FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="模式" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ModeText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="最近同步" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding AgoText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="今日专注" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding TodayFocusText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="状态" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding HasWindowTitle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="窗口标题" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="JoinOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsJoinDialogOpen, Converter={StaticResource BoolToVisibility}}"
              MouseLeftButtonDown="JoinOverlay_MouseLeftButtonDown">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#17171A"
                    BorderBrush="{StaticResource BrushGlassBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                <local:JoinRoomView />
            </Border>
        </Grid>

        <Grid x:Name="AppEditorOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Opacity="0" Visibility="Collapsed"
              MouseLeftButtonDown="AppEditorOverlay_MouseLeftButtonDown">
            <Border x:Name="AppEditorPanel" Width="500" HorizontalAlignment="Right"
                    Background="#F517171A"
                    BorderBrush="{StaticResource BrushGlassBorder}"
                    BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AppEditorSlide" X="28" />
                </Border.RenderTransform>
                <local:AppEditorView />
            </Border>
        </Grid>
    </Grid>
        </Grid>
    </Border>
</Window>
