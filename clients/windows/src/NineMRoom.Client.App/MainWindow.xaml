<Window x:Class="NineMRoom.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="9mRoom"
        Width="{StaticResource SizeWindowWidth}"
        Height="{StaticResource SizeWindowHeight}"
        MinWidth="{StaticResource SizeWindowMinWidth}"
        MinHeight="{StaticResource SizeWindowMinHeight}"
        WindowStyle="None"
        Background="{StaticResource BrushSurface}"
        Foreground="{StaticResource BrushOnSurface}"
        FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:StringEqualsConverter x:Key="ModeEquals" />

    <Style x:Key="MemberRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource M3ListItem}">
      <Setter Property="MinHeight" Value="{StaticResource SizeListTwoLine}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="MetadataRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="{StaticResource SizeListOneLine}" />
      <Setter Property="Margin" Value="0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== Top app bar：持久连接状态 + 窗口控制 ==================== -->
    <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
      <Grid x:Name="TitleBar" Height="{StaticResource SizeAppBar}" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image Source="Assets/9mRoom-mark.png" Height="20" Width="30"
                 Stretch="Uniform" Margin="0,0,10,0" />
          <TextBlock Text="9mRoom" Style="{DynamicResource M3TitleMedium}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 持久状态：已连接 · N 人在线 / 正在重连… / 未连接。不使用 Snackbar。 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTip="连接状态会持续显示，直到连接状态真实改变。">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ConnectionState}" Value="connected">
                    <Setter Property="Fill" Value="{StaticResource BrushStatusFocus}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ConnectionState}" Value="reconnecting">
                    <Setter Property="Fill" Value="{StaticResource BrushStatusBreak}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding ConnectionText}" Style="{DynamicResource M3BodyMedium}"
                     Foreground="{StaticResource BrushOnSurfaceVariant}"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <controls:M3Button x:Name="OverflowButton"
                             Style="{StaticResource M3IconButton}"
                             ToolTip="更多操作"
                             AutomationProperties.Name="更多操作"
                             Click="Overflow_Click">
            <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>

          <Border Width="1" Height="24" Background="{StaticResource BrushOutlineVariant}" Margin="4,0" />

          <controls:M3Button x:Name="MinimizeButton" Style="{StaticResource M3CaptionButton}"
                             ToolTip="最小化" AutomationProperties.Name="最小化" Click="Minimize_Click">
            <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
          <controls:M3Button x:Name="MaximizeButton" Style="{StaticResource M3CaptionButton}"
                             ToolTip="最大化" AutomationProperties.Name="最大化" Click="Maximize_Click">
            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="16" Height="16"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
          <controls:M3Button x:Name="CloseButton" Style="{StaticResource M3CloseCaptionButton}"
                             ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Click="Close_Click">
            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
          </controls:M3Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 重连中的不确定进度：持久状态的一部分，不是 Snackbar。 -->
    <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3" Margin="0,0,0,-1"
                 IsIndeterminate="True" Panel.ZIndex="5">
      <ProgressBar.Style>
        <Style TargetType="ProgressBar" BasedOn="{StaticResource M3LinearProgress}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionState}" Value="reconnecting">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ProgressBar.Style>
    </ProgressBar>

    <!-- 长期系统告警（例如托盘不可用）：常驻提示条，不进入 Snackbar。 -->
    <Border Grid.Row="1" Margin="24,12,24,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource M3BannerError}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding PersistentNoticeText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PersistentNoticeText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                 Foreground="{StaticResource BrushOnErrorContainer}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{Binding PersistentNoticeText}" Style="{StaticResource M3BannerText}" />
      </StackPanel>
    </Border>

    <!-- ==================== 导航 + 页面 ==================== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:NavigationRail x:Name="NavRail" Grid.Row="0"
                                 SelectedIndex="0"
                                 SelectionChanged="NavRail_SelectionChanged"
                                 AutomationProperties.Name="主导航">
          <controls:NavigationRail.ItemsSource>
            <x:Array Type="{x:Type controls:NavDestination}">
              <controls:NavDestination Label="自习" Tag="room" Glyph="HomeOutline" AutomationName="自习" />
              <controls:NavDestination Label="专注" Tag="focus" Glyph="TimerOutline" AutomationName="专注" />
              <controls:NavDestination Label="待办" Tag="todo" Glyph="FormatListChecks" AutomationName="待办" />
              <controls:NavDestination Label="状态" Tag="layout" Glyph="ViewDashboardOutline" AutomationName="状态" />
              <controls:NavDestination Label="应用" Tag="apps" Glyph="Apps" AutomationName="应用" />
              <controls:NavDestination Label="设置" Tag="settings" Glyph="CogOutline" AutomationName="设置" />
            </x:Array>
          </controls:NavigationRail.ItemsSource>
        </controls:NavigationRail>

        <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainerLow}" Padding="16,8">
          <TextBlock Foreground="{StaticResource BrushOnSurfaceVariant}"
                     TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource M3BodySmall}">
                <Setter Property="Text" Value="{Binding VersionText, StringFormat=版本 {0}}" />
                <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCollapsed, ElementName=NavRail}" Value="True">
                    <Setter Property="Text" Value="{Binding VersionText}" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>

      <Grid Grid.Column="1" Margin="32,24,0,24">

        <!-- ==================== 自习室 ==================== -->
        <Grid x:Name="RoomPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,28,0">
            <TextBlock Text="自习室" Style="{StaticResource PageTitle}" />
          </StackPanel>

          <controls:M3TabControl x:Name="RoomTabs" Grid.Row="1" Margin="0,8,28,0" SelectedIndex="0"
                                 SelectionChanged="RoomTabs_SelectionChanged">
            <TabItem Header="状态" />
            <TabItem Header="房间" />
            <TabItem Header="日志" />
            <TabItem Header="聊天" />
          </controls:M3TabControl>

          <Grid Grid.Row="2" Margin="0,20,0,0">

            <!-- 状态 -->
            <ScrollViewer x:Name="StateTabContent" Style="{StaticResource M3PageScroll}">
              <StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBox x:Name="ServerBox"
                           Grid.Column="0"
                           Text="{Binding ServerBase, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource M3TextBox}"
                           controls:M3Field.Label="服务器地址"
                           IsReadOnly="{Binding IsConnected}"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0" />

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,20,0,0">
                    <controls:M3Button x:Name="ConnectButton"
                                       Style="{StaticResource M3FilledButton}"
                                       Content="{Binding ConnectButtonText}"
                                       IsBusy="{Binding IsConnecting}"
                                       AutomationProperties.Name="连接或断开服务器"
                                       Click="Connect_Click" />
                    <controls:M3Button Style="{StaticResource M3OutlinedButton}"
                                       Content="离开房间"
                                       Margin="8,0,0,0"
                                       AutomationProperties.Name="离开房间"
                                       Click="LeaveRoom_Click"
                                       Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>

                <!-- 空状态：还没有加入房间 -->
                <controls:EmptyState Margin="0,32,0,0"
                                     Glyph="AccountGroupOutline"
                                     Title="还没有加入房间"
                                     Body="连接服务器并加入一个房间后，你的应用、音乐与专注状态会同步给同一房间的人。">
                  <controls:EmptyState.Style>
                    <Style TargetType="{x:Type controls:EmptyState}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:EmptyState.Style>
                  <controls:EmptyState.ActionContent>
                    <controls:M3Button Style="{StaticResource M3FilledButton}"
                                       Content="打开房间"
                                       AutomationProperties.Name="打开房间"
                                       Click="OpenJoin_Click"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                  </controls:EmptyState.ActionContent>
                </controls:EmptyState>

                <!-- 我的状态 -->
                <StackPanel Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="我的状态" Style="{StaticResource SectionTitle}" Margin="0,32,0,0" />

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,6,8,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                              <Setter Property="Fill" Value="{StaticResource BrushStatusBreak}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ManualMode}" Value="focusing">
                              <Setter Property="Fill" Value="{StaticResource BrushStatusFocus}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ManualMode}" Value="invisible">
                              <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1"
                               Text="{Binding MyStatusText}"
                               Style="{DynamicResource M3BodyLarge}"
                               TextWrapping="Wrap" />
                  </Grid>

                  <TextBlock Text="{Binding ManualModeText, StringFormat=当前模式：{0}}"
                             Style="{StaticResource ItemSupporting}" Margin="18,4,0,0"
                             TextWrapping="Wrap" />

                  <TextBlock Text="切换模式" Style="{StaticResource ItemSupporting}" Margin="0,20,0,0" />

                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                              AutomationProperties.Name="互斥的在线状态选择">
                    <controls:M3SegmentedButton Content="自动" Tag="auto" GroupName="Mode" Position="First"
                                                Checked="Mode_Checked"
                                                IsChecked="{Binding ManualMode, Converter={StaticResource ModeEquals}, ConverterParameter=auto, Mode=OneWay}" />
                    <controls:M3SegmentedButton Content="专注" Tag="focusing" GroupName="Mode" Position="Middle"
                                                Checked="Mode_Checked"
                                                IsChecked="{Binding ManualMode, Converter={StaticResource ModeEquals}, ConverterParameter=focusing, Mode=OneWay}" />
                    <controls:M3SegmentedButton Content="休息" Tag="break" GroupName="Mode" Position="Middle"
                                                Checked="Mode_Checked"
                                                IsChecked="{Binding ManualMode, Converter={StaticResource ModeEquals}, ConverterParameter=break, Mode=OneWay}" />
                    <controls:M3SegmentedButton Content="离开" Tag="away" GroupName="Mode" Position="Middle"
                                                Checked="Mode_Checked"
                                                IsChecked="{Binding ManualMode, Converter={StaticResource ModeEquals}, ConverterParameter=away, Mode=OneWay}" />
                    <controls:M3SegmentedButton Content="隐身" Tag="invisible" GroupName="Mode" Position="Last"
                                                Checked="Mode_Checked"
                                                IsChecked="{Binding ManualMode, Converter={StaticResource ModeEquals}, ConverterParameter=invisible, Mode=OneWay}" />
                  </StackPanel>

                  <TextBlock Text="同步详情" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前待办" Style="{StaticResource ItemSupporting}"
                               VerticalAlignment="Top" Margin="0,2,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ActiveTodoText}"
                               Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                  </Grid>

                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                      <TextBlock Text="应用" Style="{StaticResource ItemSupporting}" />
                      <TextBlock Text="{Binding MyAppText}" Style="{StaticResource BodyText}"
                                 TextWrapping="Wrap" Margin="0,2,0,14" />
                      <TextBlock Text="空闲" Style="{StaticResource ItemSupporting}" />
                      <TextBlock Text="{Binding MyIdleText}" Style="{StaticResource BodyText}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                      <TextBlock Text="音乐" Style="{StaticResource ItemSupporting}" />
                      <TextBlock Text="{Binding MyMediaText}" Style="{StaticResource BodyText}"
                                 TextWrapping="Wrap" Margin="0,2,0,14" />
                      <TextBlock Text="同步" Style="{StaticResource ItemSupporting}" />
                      <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource BodyText}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- 房间 -->
            <Grid x:Name="RoomTabContent" Visibility="Collapsed">
              <controls:EmptyState Glyph="DoorOpen"
                                   Title="你还没有进入房间"
                                   Body="连接服务器后，从房间页加入一个房间开始自习。">
                <controls:EmptyState.Style>
                  <Style TargetType="{x:Type controls:EmptyState}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:EmptyState.Style>
                <controls:EmptyState.ActionContent>
                  <controls:M3Button Style="{StaticResource M3FilledButton}"
                                     Content="加入房间"
                                     IsEnabled="{Binding IsConnected}"
                                     AutomationProperties.Name="加入房间"
                                     Click="OpenJoin_Click" />
                </controls:EmptyState.ActionContent>
              </controls:EmptyState>

              <ScrollViewer Style="{StaticResource M3PageScroll}"
                            Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RoomDisplayName}" Style="{DynamicResource M3TitleLarge}"
                                 Cursor="Hand" ToolTip="点击复制房间码"
                                 MouseLeftButtonUp="CopyRoomCode_Click" />
                      </StackPanel>
                      <TextBlock Text="{Binding RoomCodeDisplayText}" Style="{StaticResource ItemSupporting}"
                                 Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding MemberCountText}"
                               Style="{StaticResource ItemSupporting}"
                               VerticalAlignment="Top" Margin="16,8,0,0" />
                  </Grid>

                  <TextBlock Text="房间成员" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                  <TextBlock Text="在线成员排在前面；点击成员查看详情。"
                             Style="{StaticResource ItemSupporting}" Margin="0,0,0,8" />

                  <ListBox x:Name="MemberList" ItemsSource="{Binding Members}"
                           ItemContainerStyle="{StaticResource MemberRowStyle}"
                           SelectionChanged="MemberList_SelectionChanged"
                           AutomationProperties.Name="房间成员列表">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Border Width="40" Height="40" CornerRadius="20"
                                  Background="{StaticResource BrushPrimaryContainer}"
                                  Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initial}"
                                       Foreground="{StaticResource BrushOnPrimaryContainer}"
                                       FontSize="{StaticResource TypeTitleMediumSize}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>

                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                              <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource ItemSupporting}"
                                         Margin="8,0,0,0" VerticalAlignment="Center" />
                              <TextBlock Text="离线"
                                         Foreground="{StaticResource BrushStatusOffline}"
                                         Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ItemSupporting}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Fill" Value="{StaticResource BrushStatusFocus}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                      <Setter Property="Fill" Value="{StaticResource BrushStatusOffline}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AgoText}" Style="{StaticResource ItemSupporting}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 日志 -->
            <Grid x:Name="LogTabContent" Visibility="Collapsed">
              <ScrollViewer Style="{StaticResource M3PageScroll}">
                <StackPanel>
                  <TextBlock Text="房间日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding RoomLogs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid MinHeight="44" Margin="0,0,0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Time}" Style="{StaticResource ItemSupporting}"
                                     FontFamily="{StaticResource FontMono}" VerticalAlignment="Top"
                                     Margin="0,3,0,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{DynamicResource M3BodyMedium}"
                                     TextWrapping="Wrap" VerticalAlignment="Top" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="还没有房间日志。成员进入、离开和状态变化会记录在这里。"
                             Margin="0,8,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding RoomLogs.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 聊天 -->
            <Grid x:Name="ChatTabContent" Visibility="Collapsed">
              <local:ChatPanel />
            </Grid>
          </Grid>
        </Grid>

        <local:FocusView x:Name="FocusPage" Visibility="Collapsed" />
        <local:TodoView x:Name="TodoPage" Visibility="Collapsed" />
        <local:LayoutView x:Name="LayoutPage" Visibility="Collapsed" />
        <local:AppView x:Name="AppPage" Visibility="Collapsed" />
        <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
      </Grid>
    </Grid>

    <!-- ==================== 成员详情（side sheet） ==================== -->
    <Grid x:Name="MemberDrawerOverlay" Grid.RowSpan="3" Background="Transparent"
          Opacity="0" Visibility="Collapsed">
      <Border Background="{StaticResource BrushScrim}" Opacity="{StaticResource StateScrim}"
              MouseLeftButtonDown="MemberDrawerOverlay_MouseLeftButtonDown" />
      <Border x:Name="MemberDrawerPanel" Width="{StaticResource SizeSideSheet}"
              HorizontalAlignment="Right"
              Style="{StaticResource M3SideSheet}"
              VerticalAlignment="Stretch">
        <Border.RenderTransform>
          <TranslateTransform X="400" />
        </Border.RenderTransform>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel DataContext="{Binding SelectedMember}">
            <Grid Margin="0,0,0,16">
              <TextBlock Text="成员详情" Style="{DynamicResource M3TitleLarge}" VerticalAlignment="Center" />
              <controls:M3Button HorizontalAlignment="Right"
                                 Style="{StaticResource M3IconButton}"
                                 ToolTip="关闭成员详情"
                                 AutomationProperties.Name="关闭成员详情"
                                 Click="CloseDrawer_Click">
                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              </controls:M3Button>
            </Grid>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Width="48" Height="48" CornerRadius="24"
                      Background="{StaticResource BrushPrimaryContainer}" Margin="0,0,12,0">
                <TextBlock Text="{Binding Initial}"
                           Foreground="{StaticResource BrushOnPrimaryContainer}"
                           FontSize="{StaticResource TypeTitleMediumSize}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource ItemSupporting}" />
              </StackPanel>
              <controls:M3Button Grid.Column="2"
                                 Style="{StaticResource M3FilledTonalButton}"
                                 Content="戳一下"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="戳一下该成员"
                                 Click="PokeMember_Click"
                                 Visibility="{Binding CanPoke, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <TextBlock Text="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,12">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Border Style="{StaticResource M3Divider}" />
            <Grid MinHeight="56">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="模式" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ModeText}" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Border Style="{StaticResource M3Divider}" />
            <Grid MinHeight="56">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="最近同步" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding AgoText}" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource M3Divider}" />
            <Grid MinHeight="56">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="今日专注" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding TodayFocusText}" Style="{StaticResource ValueText}"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource M3Divider}" />
            <Grid MinHeight="56">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="状态" Style="{StaticResource ItemSupporting}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource ValueText}"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource M3Divider}" />

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ==================== 加入房间（dialog） ==================== -->
    <Grid x:Name="JoinOverlay" Grid.RowSpan="3" Background="Transparent"
          Visibility="{Binding IsJoinDialogOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{StaticResource BrushScrim}" Opacity="{StaticResource StateScrim}"
              MouseLeftButtonDown="JoinOverlay_MouseLeftButtonDown" />
      <Border Style="{StaticResource M3DialogSurface}" Width="{StaticResource SizeDialogMax}"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <local:JoinRoomView />
      </Border>
    </Grid>

    <!-- ==================== 应用规则编辑（side sheet） ==================== -->
    <Grid x:Name="AppEditorOverlay" Grid.RowSpan="3" Background="Transparent"
          Opacity="0" Visibility="Collapsed">
      <Border Background="{StaticResource BrushScrim}" Opacity="{StaticResource StateScrim}"
              MouseLeftButtonDown="AppEditorOverlay_MouseLeftButtonDown" />
      <Border x:Name="AppEditorPanel" Width="{StaticResource SizeSideSheet}"
              HorizontalAlignment="Right"
              Padding="24,24,0,24"
              Style="{StaticResource M3SideSheet}">
        <Border.RenderTransform>
          <TranslateTransform x:Name="AppEditorSlide" X="28" />
        </Border.RenderTransform>
        <local:AppEditorView />
      </Border>
    </Grid>

    <!-- ==================== 确认对话框与 Snackbar ==================== -->
    <controls:M3DialogHost x:Name="DialogHost" Grid.RowSpan="3" />

    <controls:M3Snackbar x:Name="Snackbar" Grid.RowSpan="3"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Margin="24,0,24,24" />
  </Grid>
</Window>
