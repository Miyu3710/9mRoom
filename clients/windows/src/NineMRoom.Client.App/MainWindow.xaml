<Window x:Class="NineMRoom.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="9mRoom"
        Width="{StaticResource LayoutWindowWidth}"
        Height="{StaticResource LayoutWindowHeight}"
        MinWidth="900"
        MinHeight="560"
        WindowStyle="None"
        Background="#01000000"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Background" Value="{StaticResource BrushControlBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="MinWidth" Value="220" />
        </Style>

        <Style x:Key="ServerInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushControlHover}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushDanger}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
        </Style>

        <local:CategoryMatchConverter x:Key="ModeMatch" />

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ModeMatch}">
                            <Binding Path="ManualMode" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="12" Padding="12,0">
                            <ContentPresenter Margin="0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoomTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBg" Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{StaticResource BrushControlHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            BorderBrush="{StaticResource BrushGlassBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF17161C" Offset="0" />
                <GradientStop Color="#FF111116" Offset="0.55" />
                <GradientStop Color="#FF191722" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/9mRoom-mark.png" Height="18" Width="28"
                           Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="9mRoom" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold" />
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom" Background="#1AFFFFFF" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" />
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0"
                Background="#FF1B1B21"
                BorderBrush="{StaticResource BrushGlassBorder}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <RadioButton x:Name="RoomNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" IsChecked="True" Checked="RoomNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="自习室" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FocusNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="FocusNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TimerOutline" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="专注" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TodoNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="TodoNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListChecks" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="待办" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LayoutNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="LayoutNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="状态" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AppNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="AppNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="应用" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavItem}"
                                 GroupName="Nav" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,10,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="设置" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource BrushSurface}" CornerRadius="12"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Label}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText, StringFormat=v{0}}" Style="{StaticResource Label}"
                                   FontSize="{StaticResource FontSizeXs}" Margin="14,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Margin="26,24,28,24">
            <Grid x:Name="RoomPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="自习室" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Grid.RowSpan="2"
                        Background="{StaticResource BrushGlassSurface}"
                        BorderBrush="{StaticResource BrushGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="18" />

                <Grid x:Name="TabStrip" Grid.Row="1" Height="46" Margin="0"
                      Loaded="TabStrip_Loaded">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <RadioButton x:Name="StateTabButton" Content="状态" GroupName="RoomTabs"
                                     Style="{StaticResource RoomTab}" IsChecked="True" Checked="StateTab_Checked" />
                        <RadioButton x:Name="RoomTabButton" Content="房间" GroupName="RoomTabs"
                                     Style="{StaticResource RoomTab}" Checked="RoomTab_Checked" />
                        <RadioButton x:Name="LogTabButton" Content="日志" GroupName="RoomTabs"
                                     Style="{StaticResource RoomTab}" Checked="LogTab_Checked" />
                        <RadioButton x:Name="ChatTabButton" Content="聊天" GroupName="RoomTabs"
                                     Style="{StaticResource RoomTab}" Checked="ChatTab_Checked" />
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom"
                            Background="{StaticResource BrushBorder}" />
                    <Border x:Name="TabIndicator"
                            Width="0"
                            Height="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource BrushAccent}"
                            CornerRadius="2,2,0,0"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2" x:Name="StateTabContent"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,18,24">
                        <StackPanel Margin="4,4,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="服务器地址" Style="{StaticResource Label}"
                                               Margin="4,0,0,6" />
                                    <Border Height="48"
                                            Background="{StaticResource BrushSurfaceAlt}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="13,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Server"
                                                                     Width="18" Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ServerBase, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ServerInput}"
                                                     Margin="10,0,0,0"
                                                     VerticalContentAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <Button Content="{Binding ConnectButtonText}" Click="Connect_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                    <Button Content="离开房间" Click="LeaveRoom_Click"
                                            Style="{StaticResource SecondaryButton}"
                                            Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="连接后会自动同步当前应用、音乐与专注状态。"
                                       Style="{StaticResource Label}"
                                       Margin="4,8,0,0" />
                            <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource BrushBreak}"
                                       FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Margin="4,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoticeText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="4,18,4,18" />

                        <Border Margin="0,0,0,16" Padding="26">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="520" Margin="0,12">
                                <Border Width="56" Height="56" CornerRadius="18"
                                        Background="{StaticResource BrushAccentSoft}"
                                        HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                             Width="28" Height="28"
                                                             Foreground="{StaticResource BrushAccent}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="连接服务器，开始今天的自习" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="已连接，加入一个房间" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,8,0,16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                            <Setter Property="Text" Value="输入服务器地址并连接，进入房间后会同步你的应用与专注状态。" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="从“房间”标签加入一个房间，或创建一个新房间。" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="999"
                                            Padding="10,5" Margin="0,0,6,0">
                                        <TextBlock Text="自动同步" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                    </Border>
                                    <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="999"
                                            Padding="10,5">
                                        <TextBlock Text="隐私可控" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="打开房间" Click="OpenJoin_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center" Margin="0,18,0,0"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                    <Border Margin="4,0,4,16" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Visibility="{Binding IsInRoom, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                                <TextBlock Text="我的状态" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MyStatusText}" Style="{StaticResource Body}" Margin="0,10,0,0" />

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="自动" Tag="auto" Click="Mode_Click" Style="{StaticResource ModeButton}" Margin="0,0,4,4" />
                                    <Button Content="专注" Tag="focusing" Click="Mode_Click" Style="{StaticResource ModeButton}" Margin="0,0,4,4" />
                                    <Button Content="休息" Tag="break" Click="Mode_Click" Style="{StaticResource ModeButton}" Margin="0,0,4,4" />
                                    <Button Content="离开" Tag="away" Click="Mode_Click" Style="{StaticResource ModeButton}" Margin="0,0,4,4" />
                                    <Button Content="隐身" Tag="invisible" Click="Mode_Click" Style="{StaticResource ModeButton}" Margin="0,0,4,4" />
                                </WrapPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前待办" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveTodoText}" Style="{StaticResource Body}" />
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="应用" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyAppText}" Style="{StaticResource Body}" Margin="0,2,0,10" />
                                        <TextBlock Text="空闲" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyIdleText}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="音乐" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MyMediaText}" Style="{StaticResource Body}" Margin="0,2,0,10" />
                                        <TextBlock Text="同步" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" x:Name="RoomTabContent" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="56" Height="56" CornerRadius="18"
                                Background="{StaticResource BrushAccentSoft}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="DoorOpen"
                                                     Width="28" Height="28"
                                                     Foreground="{StaticResource BrushAccent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="你未进入房间" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="连接服务器后，加入一个房间开始自习。" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" Margin="0,8,0,16" />
                        <Button Content="加入房间" Click="OpenJoin_Click" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                    <StackPanel Margin="14,6,42,16">
                    <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoomDisplayName}"
                                               FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                               Cursor="Hand" ToolTip="点击复制房间码"
                                               MouseLeftButtonUp="RoomName_Click" />
                                    <TextBlock Text="{Binding RoomCodeDisplayText}" FontSize="{StaticResource FontSizeSm}"
                                               TextWrapping="Wrap" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRoomCodeNotice}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding MemberCountText}" Style="{StaticResource Label}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>

                            <TextBlock Text="房间成员" Style="{StaticResource Label}"
                                       DockPanel.Dock="Top" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                                    MouseLeftButtonUp="MemberRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}"
                                                            Background="{StaticResource BrushAccent}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="{StaticResource BrushOnAccent}"
                                                                   FontSize="{StaticResource FontSizeLg}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF"
                                                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                                                            <Border Background="{StaticResource BrushSurface}" CornerRadius="{StaticResource RadiusSm}"
                                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Label}" FontSize="{StaticResource FontSizeXs}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Label}"
                                                                   FontSize="{StaticResource FontSizeXs}" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasWindowTitle, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource BrushFocus}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushOffline}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding AgoText}" Style="{StaticResource Label}" FontSize="{StaticResource FontSizeXs}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" x:Name="LogTabContent" Visibility="Collapsed">
                    <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="14,6,42,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RoomLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Label}"
                                                       FontSize="{StaticResource FontSizeXs}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}"
                                                       FontSize="{StaticResource FontSizeSm}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" x:Name="ChatTabContent" Visibility="Collapsed">
                    <local:ChatPanel Margin="14,6,42,16" />
                </Grid>
            </Grid>

            <local:FocusView x:Name="FocusPage" Visibility="Collapsed" />

            <local:TodoView x:Name="TodoPage" Visibility="Collapsed" />

            <local:LayoutView x:Name="LayoutPage" Visibility="Collapsed" />

            <local:AppView x:Name="AppPage" Visibility="Collapsed" />

            <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="MemberDrawerOverlay" Grid.ColumnSpan="2"
              Background="#99000000" Opacity="0" Visibility="Collapsed"
              MouseLeftButtonDown="MemberDrawerOverlay_MouseLeftButtonDown">
            <Border x:Name="MemberDrawerPanel" Width="400" HorizontalAlignment="Right"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1,0,0,0"
                    Padding="22">
                <Border.RenderTransform>
                    <TranslateTransform X="400" />
                </Border.RenderTransform>
                <StackPanel DataContext="{Binding SelectedMember}">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="成员详情" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                        <Button Content="×" Click="CloseDrawer_Click" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}" Padding="8,3" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}"
                                Background="{StaticResource BrushAccent}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Initial}" Foreground="{StaticResource BrushOnAccent}"
                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF"
                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Label}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="戳一下" Click="PokeMember_Click"
                                Style="{StaticResource PrimaryButton}" Padding="14,6"
                                FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Visibility="{Binding CanPoke, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBlock Text="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{StaticResource BrushAccent}" FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.PokeStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="模式" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ModeText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="最近同步" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding AgoText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="今日专注" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding TodayFocusText}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    <TextBlock Text="状态" Style="{StaticResource Label}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding HasWindowTitle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="窗口标题" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="JoinOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsJoinDialogOpen, Converter={StaticResource BoolToVisibility}}"
              MouseLeftButtonDown="JoinOverlay_MouseLeftButtonDown">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#17171A"
                    BorderBrush="{StaticResource BrushGlassBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                <local:JoinRoomView />
            </Border>
        </Grid>

        <Grid x:Name="AppEditorOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Opacity="0" Visibility="Collapsed"
              MouseLeftButtonDown="AppEditorOverlay_MouseLeftButtonDown">
            <Border x:Name="AppEditorPanel" Width="500" HorizontalAlignment="Right"
                    Background="#F517171A"
                    BorderBrush="{StaticResource BrushGlassBorder}"
                    BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AppEditorSlide" X="28" />
                </Border.RenderTransform>
                <local:AppEditorView />
            </Border>
        </Grid>
    </Grid>
        </Grid>
    </Border>
</Window>
