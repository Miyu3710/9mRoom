<UserControl x:Class="NineMRoom.Client.App.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChatMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="11,8" Margin="0,0,0,8" CornerRadius="{StaticResource RadiusSm}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}" />
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Label}"
                                                   FontSize="{StaticResource FontSizeXs}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BrushSurfaceAlt}"
                BorderThickness="0"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatBox" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" MaxLength="500"
                         Background="Transparent" BorderThickness="0"
                         Padding="12,0" Height="64"
                         VerticalContentAlignment="Center"
                         KeyDown="ChatBox_KeyDown" />
                <Border Grid.Column="1" Width="1" Margin="0,8"
                        Background="{StaticResource BrushBorder}" />
                <Button Grid.Column="2" Click="Send_Click"
                        Style="{StaticResource InlineTextButton}">
                    <Grid Width="72">
                        <TextBlock Text="发送"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
