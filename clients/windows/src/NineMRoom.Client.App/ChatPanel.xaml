<UserControl x:Class="NineMRoom.Client.App.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <ScrollViewer x:Name="ChatScroll" Style="{StaticResource M3PageScroll}">
        <ItemsControl x:Name="ChatItems" ItemsSource="{Binding ChatMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 其他成员头像：气泡左侧 -->
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                        Margin="0,0,8,4" VerticalAlignment="Bottom">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                          <Setter Property="Background">
                            <Setter.Value>
                              <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Initial}"
                             Foreground="{StaticResource BrushOnPrimaryContainer}"
                             FontSize="{StaticResource TypeTitleSmallSize}" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>

                <Border Grid.Column="1" MaxWidth="560" Padding="14,10" CornerRadius="12">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}" />
                      <Setter Property="HorizontalAlignment" Value="Left" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                          <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                          <Setter Property="HorizontalAlignment" Value="Right" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource ItemSupporting}">
                            <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource ItemSupporting}"
                                 Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                          <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>

                <!-- 自己的头像：气泡右侧 -->
                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="8"
                        Margin="8,0,0,4" VerticalAlignment="Bottom">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                          <Setter Property="Background">
                            <Setter.Value>
                              <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Initial}"
                             Foreground="{StaticResource BrushOnPrimaryContainer}"
                             FontSize="{StaticResource TypeTitleSmallSize}" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <controls:EmptyState Glyph="ChatOutline"
                           Title="还没有消息"
                           Body="和同房间的人打个招呼吧。消息只发送给当前房间。">
        <controls:EmptyState.Style>
          <Style TargetType="{x:Type controls:EmptyState}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:EmptyState.Style>
      </controls:EmptyState>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,28,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="ChatBox"
               Grid.Column="0"
               Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource M3TextBox}"
               controls:M3Field.Label="消息"
               MaxLength="500"
               VerticalAlignment="Top"
               Margin="0,0,12,0"
               KeyDown="ChatBox_KeyDown" />

      <controls:M3Button x:Name="SendButton"
                         Grid.Column="1"
                         Style="{StaticResource M3IconButtonFilled}"
                         ToolTip="发送消息"
                         AutomationProperties.Name="发送消息"
                         VerticalAlignment="Top"
                         Margin="0,20,0,0"
                         Click="Send_Click">
        <materialDesign:PackIcon Kind="Send" Width="20" Height="20"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
      </controls:M3Button>
    </Grid>
  </Grid>
</UserControl>
