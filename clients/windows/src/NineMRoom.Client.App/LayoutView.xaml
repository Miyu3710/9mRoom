<UserControl x:Class="NineMRoom.Client.App.LayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,28,16">
      <TextBlock Text="状态" Style="{StaticResource PageTitle}" />
      <TextBlock Text="编排在房间里展示的同步列表；顺序、启用状态与模板都会同步给同房间的人。"
                 Style="{StaticResource PageSupporting}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource M3PageScroll}">
      <StackPanel>

        <!-- 预览：唯一保留的独立卡片（它确实是独立的预览实体） -->
        <Border Style="{StaticResource M3PreviewSurface}">
          <StackPanel>
            <TextBlock Text="预览" Style="{StaticResource ItemSupporting}" Margin="0,0,0,6" />
            <TextBlock Style="{DynamicResource M3BodyMedium}">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 的同步状态" />
            </TextBlock>
            <TextBlock Text="{Binding MyStatusText}" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Text="同步块" Style="{StaticResource SectionTitle}" Margin="0,24,0,4" />
        <TextBlock Text="拖动左侧手柄调整顺序；关闭复选会停止同步该块，但保留模板。"
                   Style="{StaticResource ItemSupporting}" Margin="0,0,0,8" />

        <Grid>
          <ItemsControl x:Name="LayoutItems" ItemsSource="{Binding LayoutBlocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
                  <Grid MinHeight="64" Margin="0,4,0,4">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <Setter Property="Opacity" Value="0.3" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="拖动排序"
                            AutomationProperties.Name="拖动排序"
                            VerticalAlignment="Top"
                            PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                            MouseMove="DragHandle_MouseMove"
                            MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                      <materialDesign:PackIcon Kind="DragVertical" Width="20" Height="20"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource M3CheckBox}"
                              IsChecked="{Binding Enabled}"
                              ToolTip="启用此块"
                              AutomationProperties.Name="启用此同步块"
                              VerticalAlignment="Top"
                              Margin="0,0,8,0" />

                    <TextBox Grid.Column="2"
                             Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource M3TextBoxCompact}"
                             controls:M3Field.Label="{Binding Label}"
                             VerticalAlignment="Top"
                             Margin="8,0,8,0" />

                    <controls:M3Button Grid.Column="3"
                                       Style="{StaticResource M3IconButton}"
                                       ToolTip="删除此块"
                                       AutomationProperties.Name="删除此同步块"
                                       Tag="{Binding}"
                                       VerticalAlignment="Top"
                                       Click="Remove_Click">
                      <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                    </controls:M3Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="False" />
        </Grid>

        <!-- 添加块：Assist chip（紧凑动作集） -->
        <TextBlock Text="添加同步块" Style="{StaticResource ItemSupporting}" Margin="0,20,0,6" />
        <WrapPanel>
          <controls:M3Button Style="{StaticResource M3AssistChip}" Tag="app" Click="AddBlock_Click" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              <TextBlock Text="应用" />
            </StackPanel>
          </controls:M3Button>
          <controls:M3Button Style="{StaticResource M3AssistChip}" Tag="media" Click="AddBlock_Click" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              <TextBlock Text="音乐" />
            </StackPanel>
          </controls:M3Button>
          <controls:M3Button Style="{StaticResource M3AssistChip}" Tag="timer" Click="AddBlock_Click" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              <TextBlock Text="计时" />
            </StackPanel>
          </controls:M3Button>
          <controls:M3Button Style="{StaticResource M3AssistChip}" Tag="todo" Click="AddBlock_Click" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              <TextBlock Text="待办" />
            </StackPanel>
          </controls:M3Button>
          <controls:M3Button Style="{StaticResource M3AssistChip}" Click="AddCustom_Click" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
              <TextBlock Text="自定义" />
            </StackPanel>
          </controls:M3Button>
        </WrapPanel>

        <TextBlock Text="{Binding LayoutNotice}" Style="{StaticResource ErrorText}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <controls:M3Button Style="{StaticResource M3TextButtonNeutral}" Content="恢复默认布局"
                             Click="Reset_Click" />
          <controls:M3Button x:Name="HelpButton"
                             Style="{StaticResource M3TextButtonNeutral}"
                             Content="占位符说明"
                             Margin="8,0,0,0"
                             Click="Help_Click" />
        </StackPanel>

        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{StaticResource BrushSurfaceContainerHigh}"
                  BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                  CornerRadius="{StaticResource ShapeMedium}" Padding="16" Margin="0,6,0,0"
                  MaxWidth="520">
            <StackPanel>
              <TextBlock Text="可用占位符" Style="{StaticResource ItemTitle}" Margin="0,0,0,8" />
              <TextBlock Text="{}{app}  应用显示名" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{category}  应用分类（如 coding / game）" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{title}  媒体标题" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{artist}  艺术家" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{progress}  播放进度" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{remaining}  番茄剩余时间" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
              <TextBlock Text="{}{todo}  当前待办文本" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
              <TextBlock Text="自定义块可用 ${...} 在本机执行命令，例如 ${&amp;'C:\scripts\uptime.ps1'}"
                         Style="{StaticResource HintText}" />
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
