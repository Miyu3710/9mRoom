<UserControl x:Class="NineMRoom.Client.App.LayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">

    <UserControl.Resources>
</UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,16">
            <TextBlock Text="同步列表" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="预览" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4">
                            <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=" 的同步状态" />
                        </TextBlock>
                        <TextBlock Text="{Binding MyStatusText}" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <ItemsControl x:Name="LayoutItems" ItemsSource="{Binding LayoutBlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8" Background="Transparent">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                        <Setter Property="Opacity" Value="0.3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Padding="6,4" Margin="0,0,4,0" Background="Transparent" Cursor="SizeAll"
                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                MouseMove="DragHandle_MouseMove"
                                                MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                                            <TextBlock Text="≡" Foreground="{StaticResource BrushTextMuted}"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                   Style="{StaticResource Body}" VerticalAlignment="Center" />

                                        <TextBox Grid.Column="3" Style="{StaticResource InputBox}"
                                                 Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,10,0" />

                                        <Button Grid.Column="4" Content="×" Tag="{Binding}" Click="Remove_Click"
                                                Style="{StaticResource ModernButton}" Padding="10,3" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="False" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="HelpButton" Content="?" Click="Help_Click"
                                    Style="{StaticResource ModernButton}" Width="24" Height="22" Padding="0" />
                            <TextBlock Text="占位符说明" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{StaticResource BrushSurfaceAlt}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Margin="0,4,0,0">
                                    <StackPanel MaxWidth="480">
                                        <TextBlock Text="可用占位符" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="{}{app}  应用显示名" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{category}  应用分类（如 coding / game）" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{title}  媒体标题" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{artist}  艺术家" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{progress}  播放进度" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{remaining}  番茄剩余时间" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{todo}  当前待办文本" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                        <TextBlock Text="{}{text}  自定义块文本（自定义块本身不替换）" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                        <TextBlock Text="自定义块可用 ${...} 在本机执行命令，例如 ${&amp;'C:\scripts\uptime.ps1'}"
                                                   Style="{StaticResource Label}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="添加块：" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="应用" Tag="app" Click="AddBlock_Click" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,4" />
                            <Button Content="音乐" Tag="media" Click="AddBlock_Click" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,4" />
                            <Button Content="计时" Tag="timer" Click="AddBlock_Click" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,4" />
                            <Button Content="待办" Tag="todo" Click="AddBlock_Click" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,4" />
                            <Button Content="自定义" Click="AddCustom_Click" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,4" />
                        </WrapPanel>

                        <TextBlock Text="{Binding LayoutNotice}" Foreground="{StaticResource BrushBreak}"
                                   Style="{StaticResource Label}" Margin="0,4,0,0" />

                        <Button Content="恢复默认布局" Click="Reset_Click"
                                Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
