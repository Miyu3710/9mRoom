<Window x:Class="NineMRoom.Client.App.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NineMRoom.Client.App.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="应用分类"
        Width="780" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource BrushOnSurface}"
        FontFamily="{StaticResource FontUi}"
        TextElement.Foreground="{DynamicResource BrushOnSurface}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Border Style="{StaticResource M3DialogSurface}" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="应用分类" Style="{DynamicResource M3HeadlineSmall}" VerticalAlignment="Center" />
        <controls:M3Button HorizontalAlignment="Right"
                           Style="{StaticResource M3IconButton}"
                           ToolTip="关闭"
                           AutomationProperties.Name="关闭应用分类"
                           Click="Close_Click">
          <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
        </controls:M3Button>
      </Grid>

      <TextBlock Grid.Row="1" Margin="0,0,0,12"
                 Text="分类模板只作用于 app 块；拖动 ≡ 可调整顺序，顺序会同步到应用规则。优先级：单应用模板 &gt; 分类模板 &gt; 全局模板。"
                 Style="{DynamicResource M3BodyMedium}"
                 Foreground="{StaticResource BrushOnSurfaceVariant}"
                 TextWrapping="Wrap" />

      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0">
          <ItemsControl x:Name="CategoryItems" ItemsSource="{Binding AppCategories}"
                        Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
                  <Grid MinHeight="64" Margin="0,4,0,4">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <Setter Property="Opacity" Value="0.3" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" Background="Transparent"
                            Cursor="SizeAll" ToolTip="拖动调整分类顺序"
                            AutomationProperties.Name="拖动调整分类顺序"
                            VerticalAlignment="Top"
                            PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="Handle_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Handle_PreviewMouseLeftButtonUp">
                      <materialDesign:PackIcon Kind="DragVertical" Width="20" Height="20"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource M3TextBoxCompact}"
                             controls:M3Field.Label="分类名称"
                             Margin="0,0,8,0" VerticalAlignment="Top" />

                    <TextBox Grid.Column="2" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource M3TextBoxCompact}"
                             controls:M3Field.Label="分类模板"
                             Margin="0,0,8,0" VerticalAlignment="Top" />

                    <controls:M3Button Grid.Column="3"
                                       Style="{StaticResource M3IconButton}"
                                       ToolTip="删除分类"
                                       AutomationProperties.Name="删除分类"
                                       Tag="{Binding}"
                                       VerticalAlignment="Top"
                                       Click="Remove_Click">
                      <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:M3Button}}" />
                    </controls:M3Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Canvas x:Name="DragLayer" IsHitTestVisible="False" Panel.ZIndex="20" />
      </Grid>

      <StackPanel Grid.Row="3" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="NewNameBox" Grid.Column="0"
                   Style="{StaticResource M3TextBoxCompact}"
                   controls:M3Field.Label="新分类名称"
                   Margin="0,0,8,0" VerticalAlignment="Top" />
          <TextBox x:Name="NewTemplateBox" Grid.Column="1"
                   Style="{StaticResource M3TextBoxCompact}"
                   controls:M3Field.Label="分类模板"
                   Margin="0,0,8,0" VerticalAlignment="Top" />
          <controls:M3Button Grid.Column="2"
                             Style="{StaticResource M3FilledButton}"
                             Content="新增分类"
                             VerticalAlignment="Top"
                             Margin="0,8,0,0"
                             Click="Add_Click" />
        </Grid>
        <TextBlock Text="新分类默认模板为空；删除分类后，使用该分类的应用会回到「自动」。"
                   Style="{StaticResource HintText}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <controls:M3Button Style="{StaticResource M3TextButton}" Content="完成" Click="Close_Click" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
