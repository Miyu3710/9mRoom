<Window x:Class="NineMRoom.Client.App.FontDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NineMRoom.Client.App"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="选择字体"
        Width="680" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        </Window.Resources>
    <Border Background="{StaticResource BrushSurface}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="{StaticResource RadiusLg}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="选择字体" Style="{StaticResource SectionTitle}" />
                <Button Click="Cancel_Click" HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" ToolTip="关闭">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}"
                        CornerRadius="{StaticResource RadiusSm}" Padding="4" Margin="0,0,16,0">
                    <ListBox x:Name="FontList" Background="Transparent" Foreground="{StaticResource BrushText}"
                             BorderThickness="0" local:SmoothScroll.IsEnabled="False"
                             PreviewMouseWheel="FontList_PreviewMouseWheel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Source}"
                                           FontSize="{StaticResource FontSizeSm}" Padding="6,5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="字重" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,14">
                        <RadioButton x:Name="WeightNormal" Content="常规" GroupName="Weight" Margin="0,0,16,4" />
                        <RadioButton x:Name="WeightMedium" Content="中等" GroupName="Weight" Margin="0,0,16,4" />
                        <RadioButton x:Name="WeightSemi" Content="半粗" GroupName="Weight" Margin="0,0,0,4" />
                    </WrapPanel>

                    <TextBlock Text="字号" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBox x:Name="SizeBox" Style="{StaticResource InputBox}" Width="80"
                             HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <TextBlock Text="预览" Style="{StaticResource Label}" Margin="0,4,0,6" />
                    <Border x:Name="PreviewBorder" Background="#D9232327" BorderBrush="#8034343A"
                            BorderThickness="1" CornerRadius="10" Padding="12" Height="112">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" Text="demo · 1 人在线 · 专注中"
                                       Foreground="#9B9BA4" FontSize="10" Margin="0,0,0,6" />
                            <TextBlock x:Name="PreviewText" Text="朔月 · endfield | 完成 9mRoom 待办"
                                       Foreground="#ECECF0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                <Button Content="确定" Click="Ok_Click" Style="{StaticResource ModernPrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
